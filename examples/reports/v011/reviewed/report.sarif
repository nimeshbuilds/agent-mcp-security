        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "endLine": 3,
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "The default final Dockerfile stage explicitly selects or inherits a literal root user. Build-target selection, external image defaults, variable expansion and runtime overrides require separate validation. Remediation: Use a dedicated nonroot runtime user and minimal capabilities; verify the final build stage and deployment security context. Agent/MCP relevance: An injected or overbroad agent/MCP tool action inherits the container process identity. Root can increase access to mounted data and the impact of an isolation failure, although container root is not automatically host root. Fix steps: 1. Create a dedicated service account during build and select it with USER in the final runtime stage. In Kubernetes, configure runAsNonRoot and an appropriate numeric runAsUser where required. Verify: Inspect the built image user and the running process UID under the actual deployment; test startup fails rather than silently switching to root. 2. Set ownership for explicit runtime/cache/workspace directories, avoid broad chmod permissions, and use a read-only root filesystem where compatible. Verify: Run normal tool operations and verify they work only in approved writable directories; confirm system and other-tenant paths are denied. 3. Drop unnecessary capabilities, disable privilege escalation and avoid host mounts/runtime sockets. Ensure an entrypoint does not restore privilege. Verify: Inspect effective capabilities, mounts and deployment overrides and perform denied-access tests as the worker identity."
          },
          "partialFingerprints": {
            "agentMcpScan/v1": "20771a324af20de316ec34f9"
          },
          "properties": {
            "agentMcpRemediation": {
              "agent_mcp_relevance": "An injected or overbroad agent/MCP tool action inherits the container process identity. Root can increase access to mounted data and the impact of an isolation failure, although container root is not automatically host root.",
              "applicability": [
                "The finding concerns an explicit image/build default; deployment runAsUser, rootless runtimes and user namespaces may alter its effect.",
                "Review the final selected build stage and actual running UID rather than assuming every build-stage root command runs in production."
              ],
              "catalog_sha256": "6ea5b70b817f35b68352ce9b7b443b1c01139ba7b94ee2631f5db5ef7521b96e",
              "catalog_version": "1.0.0",
