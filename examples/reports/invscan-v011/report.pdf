ty_Cheat_Sheet.html"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Prevent sensitive context leaving through legitimate tools","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI002","AI003","AI012"],"category":"Execution and application security","checks":["Find shell execution and constructed command strings; use fixed executables, argument arrays, and allowed argument values.","Test untrusted tool inputs containing shell syntax, option injection, command substitution, and hostile filenames."],"finding_ids":["979d192981c1785a2394fe19","0fa7e450cd583d78646ef397"],"id":"EXEC-01","source_ids":["OWASP-MCP10","OWASP-OUTPUT2025"],"sources":["https://owasp.org/projects/mcp-top-10","https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Prevent shell and command injection","validation":"hybrid"},{"alignment_source_ids":["OWASP-AISVS-C9","AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI001","AI013"],"category":"Execution and application security","checks":["Locate eval, exec, dynamic imports, templates, notebooks, and interpreter tools accepting model or user content.","Run required code execution in a disposable restricted environment with explicit filesystem, network, CPU, and time limits."],"finding_ids":["b1b0f0a3f33fe93875fcb58a"],"id":"EXEC-02","source_ids":["OWASP-AGENT-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/AI_Agent_Security_Cheat_Sheet.html"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Constrain generated-code execution","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI036"],"category":"Execution and application security","checks":[