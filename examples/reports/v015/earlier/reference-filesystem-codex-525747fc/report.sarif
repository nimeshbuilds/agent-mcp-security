      "results": [],
      "tool": {
        "driver": {
          "fullName": "Invarune by NimeshBuild",
          "name": "agent-mcp-security-scan",
          "rules": [
            {
              "fullDescription": {
                "text": "A filesystem operation consumes an obvious external-input expression. Review whether canonical path checks and symlink handling confine access to the intended workspace."
              },
              "help": {
                "text": "Resolve paths under a fixed workspace root, reject paths outside it after canonicalization, handle symlinks safely, and give the process only required filesystem permissions."
              },
              "id": "AI015",
              "properties": {
                "tags": [
                  "security",
                  "filesystem",
                  "CWE-22"
                ]
              },
              "shortDescription": {
                "text": "Externally influenced filesystem path"
              }
            },
            {
              "fullDescription": {
                "text": "tempfile.mktemp returns an unused name without atomically creating the file, allowing a race with another local process."
              },
              "help": {
                "text": "Use TemporaryFile, NamedTemporaryFile, TemporaryDirectory, or mkstemp with restrictive permissions and reliable cleanup."
              },
              "id": "AI016",
              "properties": {
                "tags": [
                  "security",
                  "filesystem",
                  "CWE-377"
                ]
              },
              "shortDescription": {
                "text": "Race-prone temporary filename creation"
              }
            },
            {
              "fullDescription": {
                "text": "A tar extraction call has no explicit safe data filter, or selects a fully trusted filter. Behavior depends on the Python version and archive provenance."
              },
              "help": {
                "text": "Use filter='data' on supported runtimes, validate members and resource limits, and extract into an isolated directory with no sensitive files."
              },
              "id": "AI037",
              "properties": {
                "tags": [
                  "security",
                  "filesystem",
                  "CWE-22"
                ]
              },
              "shortDescription": {
                "text": "Archive extraction without an explicit safe filter"
              }
            },
            {
              "fullDescription": {
                "text": "A recognized Python chmod call sets the other-write permission bit. Shared agent workspaces, tool artifacts or credential files may be changed by another local identity. Actual access depends on platform permissions, ownership, ACLs and deployment isolation."
              },
              "help": {
                "text": "Use owner-only permissions (typically 0o600 for private files and 0o700 for private directories), or a narrowly controlled shared group where required. Verify access from the actual worker and an unrelated identity; avoid granting 0o777 merely to fix container UID mismatches."
              },
              "id": "AI047",
              "properties": {
                "tags": [
                  "security",
                  "filesystem",
                  "CWE-732"
                ]
              },
              "shortDescription": {
                "text": "Filesystem permissions explicitly allow writes by everyone"
              }
            }
          ],
          "version": "0.15.0"
        }
      }
    }
