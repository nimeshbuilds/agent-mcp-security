/resource/owasp-top-10-for-agentic-applications-for-2026/"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Keep objectives and authority bounded across agents","validation":"dynamic"},{"alignment_source_ids":["AIUC1-Q3-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Agent behavior and context","checks":["Inventory skill files, prompts, hooks, memory seed files, MCP configuration, and other executable workflow inputs.","Require review for changes that add commands, access, or persistence; external repository text cannot become trusted policy."],"finding_ids":[],"id":"AGT-06","source_ids":["MITRE-ATLAS","NCSC-SECURE-AI"],"sources":["https://github.com/mitre-atlas/atlas-data","https://www.ncsc.gov.uk/collection/guidelines-secure-ai-system-development"],"status":"review_required","suppressed_finding_ids":[],"title":"Protect agent configuration and skills","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Agent behavior and context","checks":["Apply destination and data policies to URLs, searches, tickets, messages, uploads, and telemetry generated by agents.","Use canary data to test encoded leakage and combinations of otherwise permitted tools."],"finding_ids":[],"id":"AGT-07","source_ids":["OWASP-MCP-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/MCP_Security_Cheat_Sheet.html"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Prevent sensitive context leaving through legitimate tools","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI002","AI003","AI012"],"category":"Execution and application security","checks":["Find shell execution and constructed command strings; use fixed executables, argument arrays, and allowed argument values.","Test untrusted tool inputs containing shell syntax, option injection, command substitution, and hostile filenames."],"finding_ids":["979d192981c1785a2394fe19","0fa7e450cd583d78646ef397"],"id":"EXEC-01","source_ids":["OWASP-MCP10","OWASP-OUTPUT2025"],"sources":["https://owasp.org/projects/mcp-top-10","https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Prevent shell and command injection","validation":"hybrid"},{"alignment_source_ids":["OWASP-AISVS-C9","AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI001","AI013"],"category":"Execution and application security","checks":["Locate eval, exec, dynamic imports, templates, notebooks, and interpreter tools accepting model or user content.","Run required code execution in a disposable restricted environment with explicit filesystem, network, CPU, and time limits."],"finding_ids":["b1b0f0a3f33fe93875fcb58a"],"id":"EXEC-02","source_ids":["OWASP-AGENT-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/AI_Agent_Security_Cheat_Sheet.html"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Constrain generated-code execution","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI036"],"category":"Execution and application security","checks":["Use bound query parameters and allowed query shapes; inspect SQL, NoSQL, graph, and search-language construction.","Separate read/write database identities and test whether generated queries can escape permitted objects or operations."],"finding_ids":[],"id":"EXEC-03","source_ids":["OWASP-OUTPUT2025"],"sources":["https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Parameterize database and query operations","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI015","AI016","AI037"],"category":"Execution and application security","checks":["Resolve and enforce allowed paths at access time; constrain uploads, downloads, extraction, temporary files, and permissions.","Test symlink races, archive traversal, absolute paths, overwrite attempts, and secret-directory reads."],"finding_ids":[],"id":"EXEC-04","source_ids":["MCP-ROOTS","JOINT-DEPLOY"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/client/roots","https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Constrain file and archive access","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI014"],"category":"Execution and application security","checks":["Restrict destinations and schemes at connection time; revalidate DNS resolution and each redirect.","Test loopback, private/link-local IPv4 and IPv6, cloud metadata, alternate encodings, and redirect-to-private cases."],"finding_ids":[],"id":"EXEC-05","source_ids":["MCP-SECURITY"],"sources":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Prevent SSRF and unsafe network destinations","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI004","AI005","AI035"],"category":"Execution and application security","checks":["Inspect pickle, unsafe YAML, object deserialization, XML entity expansion, and unconstrained recursive parsers.","Use data-only formats with byte, nesting, and type limits; test malformed input and expansion attacks."],"finding_ids":["d2d09fb2875db72f18779bfc"],"id":"EXEC-06","source_ids":["NIST-SSDF"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Reject unsafe parsing and deserialization","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI039","AI040"],"category":"Execution and application security","checks":["Use context-specific escaping for HTML/Markdown, avoid unsafe DOM sinks, and validate links and embedded media.","Test active SVG/HTML, malicious URLs, terminal escapes, and spreadsheet formulas in exported reports."],"finding_ids":[],"id":"EXEC-07","source_ids":["OWASP-OUTPUT2025"],"sources":["https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Render model and tool output safely","validation":"hybrid"},{"alignment_source_ids":["AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI010","AI011","AI030","AI034"],"category":"Data and privacy","checks":["Inspect code, examples, configuration, notebooks, test fixtures, and generated artifacts for secret-like values.","Verify actual exposures with the owner, rotate real credentials, and remove them from reachable history and artifacts."],"finding_ids":["afb2bdb94696690028650faf"],"id":"DATA-01","source_ids":["JOINT-DEPLOY"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Detect and remove embedded credentials","validation":"static"},{"alignment_source_ids":["CSA-AICM","CIS-AGENTS-2026","AIUC1-Q3-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Data and privacy","checks":["Map which prompts, tool outputs, memory, and code leave the environment and identify the receiving provider/gateway.","Document allowed data classes, processing location, retention, and training use; redact before transmission where required."],"finding_ids":[],"id":"DATA-02","source_ids":["NIST-GENAI"],"sources":["https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Minimize data sent to models and gateways","validation":"manual"},{"alignment_source_ids":["CIS-AGENTS-2026","CIS-MCP-2026","AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI009","AI033"],"category":"Data and privacy","checks":["Redact secrets and sensitive payloads before logs, traces, exception strings, and dashboards persist them.","Test the failure paths and provider errors as well as success paths; restrict access and export destinations."],"finding_ids":[],"id":"DATA-03","source_ids":["OWASP-MCP10"],"sources":["https://owasp.org/projects/mcp-top-10"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Protect logs, traces, and error responses","validation":"hybrid"},{"alignment_source_ids":["CSA-AICM","NIST-SSDF-AI"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Data and privacy","checks":["Record source, owner, version, transformation history, and integrity evidence for datasets, retrieval corpora, and memory seeds.","Quarantine unexpected changes and test how poisoned or stale data is detected, removed, and replaced."],"finding_ids":[],"id":"DATA-04","source_ids":["NSA-DATA"],"sources":["https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/4192332/nsas-aisc-releases-joint-guidance-on-the-risks-and-best-practices-in-ai-data-se/"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Track provenance and integrity of AI data","validation":"manual"},{"alignment_source_ids":["CIS-AGENTS-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Data and privacy","checks":["Apply expiry and deletion to prompts, embeddings, caches, memory, tool artifacts, backups, and provider-held data.","Verify deleting a source record removes or invalidates dependent retrieval content and access grants."],"finding_ids":[],"id":"DATA-05","source_ids":["NIST-GENAI"],"sources":["https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Enforce retention and deletion across copies","validation":"dynamic"},{"alignment_source_ids":["CSA-CCM","CIS-AGENTS-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Data and privacy","checks":["Check transport verification, storage access controls, encryption settings, key separation, and backup permissions.","Validate key rotation and denied access using a principal outside the authorized tenant or operational role."],"finding_ids":[],"id":"DATA-06","source_ids":["NSA-DATA","JOINT-DEPLOY"],"sources":["https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/4192332/nsas-aisc-releases-joint-guidance-on-the-risks-and-best-practices-in-ai-data-se/","https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"],"status":"review_required","suppressed_finding_ids":[],"title":"Protect stored data and keys","validation":"hybrid"},{"alignment_source_ids":["NIST-SSDF-AI","AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI018","AI024","AI025"],"category":"Supply chain","checks":["Review lockfiles and exact versions or immutable digests for packages, images, MCP servers, models, and plugins.","Flag runtime installs, floating tags, remote scripts, and dependency sources outside approved registries."],"finding_ids":["6b77081a826c4c6833edc47f","055ed29e5f56926f1827a0b8"],"id":"SUP-01","source_ids":["NIST-SSDF"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Pin and inventory executable dependencies","validation":"static"},{"alignment_source_ids":["CSA-AISMM","CIS-MCP-2026","OPENSSF-BASELINE-202608"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Supply chain","checks":["Run appropriate package/container advisory tools against resolved dependencies and save database date and tool version.","Triage reachability, fix availability, support status, and transitive dependencies; source pattern scans do not establish CVE coverage."],"finding_ids":[],"id":"SUP-02","source_ids":["NCSC-SECURE-AI"],"sources":["https://www.ncsc.gov.uk/collection/guidelines-secure-ai-system-development"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Check vulnerability and maintenance exposure","validation":"manual"},{"alignment_source_ids":["CSA-AICM","CSA-MAESTRO","NIST-SSDF-AI","OWASP-AISVS-C10","SLSA-12","OPENSSF-MODEL-SIGNING"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI019","AI024","AI035"],"category":"Supply chain","checks":["Verify publisher identity, hashes/signatures, build provenance, and intended origin before enabling artifacts.","Review model loading and serialization behavior; an integrity hash cannot make an untrusted publisher safe."],"finding_ids":["055ed29e5f56926f1827a0b8"],"id":"SUP-03","source_ids":["NSA-DATA","NIST-SSDF"],"sources":["https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/4192332/nsas-aisc-releases-joint-guidance-on-the-risks-and-best-practices-in-ai-data-se/","https://csrc.nist.gov/pubs/sp/800/218/final"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Verify artifact identity and provenance","validation":"manual"},{"alignment_source_ids":["NIST-SSDF-AI","CIS-MCP-2026","OPENSSF-BASELINE-202608","SLSA-12"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI020"],"category":"Supply chain","checks":["Restrict CI credentials and workflow permissions; review actions, build scripts, and release provenance.","Prevent untrusted contributions from executing with deployment secrets or changing approved agent policies."],"finding_ids":[],"id":"SUP-04","source_ids":["NIST-SSDF"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Protect build, release, and configuration changes","validation":"hybrid"},{"alignment_source_ids":["CSA-CCM","CSA-MAESTRO"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI021","AI022","AI023","AI031","AI042"],"category":"Supply chain","checks":["Review root/privileged containers, host mounts, Docker sockets, unrestricted egress, debug mode, and public management endpoints.","Separate agent execution from control-plane credentials and audit storage; test isolation in the deployed environment."],"finding_ids":["592fbfc9b7dab062dc97906c","20771a324af20de316ec34f9"],"id":"SUP-05","source_ids":["JOINT-DEPLOY"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Harden runtime isolation and deployment defaults","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Supply chain","checks":["When training or fine-tuning, isolate development, evaluation, and production identities, data access, registries, and release permissions.","Protect datasets, weights, adapters, and configuration separately; monitor modifications and demonstrate that an untrusted training job cannot replace an approved production artifact."],"finding_ids":[],"id":"SUP-06","source_ids":["NIST-SSDF-AI"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/a/final"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Separate and protect model development environments","validation":"dynamic"},{"alignment_source_ids":["CSA-CCM","CSA-AGENT-IAM","CIS-AGENTS-2026","CIS-MCP-2026","OWASP-AISVS-C9"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Record initiating identity, delegated identity, tool/server/version, approved arguments, decision, outcome, and correlation identifiers.","Protect log integrity and clock consistency; ensure agents cannot erase their own action history."],"finding_ids":[],"id":"OPS-01","source_ids":["OWASP-MCP10"],"sources":["https://owasp.org/projects/mcp-top-10"],"status":"review_required","suppressed_finding_ids":[],"title":"Produce attributable audit events","validation":"hybrid"},{"alignment_source_ids":["CSA-SCOPING","OWASP-AISVS-C9","OWASP-AISVS-C10"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Set server-enforced limits for iterations, tokens, tool calls, recursion, parallelism, bytes, cost, and elapsed time.","Exercise stuck loops and amplification paths; verify limits apply across retries and child agents."],"finding_ids":[],"id":"OPS-02","source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/agentic-ai-harnesses"],"status":"review_required","suppressed_finding_ids":[],"title":"Bound work, spending, and concurrency","validation":"hybrid"},{"alignment_source_ids":["CSA-AGENT-IAM","OWASP-AISVS-C9"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Provide a tested stop mechanism that revokes work, credentials, queued actions, and child tasks.","Measure stop latency and verify cancelled or disconnected requests cannot later commit prohibited side effects."],"finding_ids":[],"id":"OPS-03","source_ids":["JOINT-AGENTIC"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/careful-adoption-of-agentic-ai-services"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Make cancellation and shutdown effective","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Deny or escalate when policy, identity, or approval checks fail; prevent fallback paths from widening privilege.","Test outages, partial failures, timeouts, retries, idempotency, and recovery of transactions with external effects."],"finding_ids":[],"id":"OPS-04","source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/agentic-ai-harnesses"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Fail safely and prevent duplicate side effects","validation":"dynamic"},{"alignment_source_ids":["CSA-CCM","CSA-AISMM"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Alert on unusual tool use, new destinations, scope growth, repeated denials, cost spikes, and unexpected state changes.","Validate alerts with seeded events and test rollback of models, prompts, tools, policies, and poisoned memory."],"finding_ids":[],"id":"OPS-05","source_ids":["NCSC-SECURE-AI"],"sources":["https://www.ncsc.gov.uk/collection/guidelines-secure-ai-system-development"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Monitor behavior and support rollback","validation":"dynamic"},{"alignment_source_ids":["CSA-AICM","CSA-CCM","CSA-AISMM","OPENSSF-BASELINE-202608"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","checks":["Maintain procedures to isolate agents, revoke credentials, preserve evidence, notify owners, and recover trusted state.","Exercise an AI-specific incident and define approved vulnerability/intelligence-sharing channels without exposing sensitive evidence."],"finding_ids":[],"id":"OPS-06","source_ids":["CISA-JCDC"],"sources":["https://www.cisa.gov/news-events/alerts/2025/01/14/cisa-releases-jcdc-ai-cybersecurity-collaboration-playbook-and-fact-sheet"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Practice incident response and disclosure","validation":"manual"},{"alignment_source_ids":["MITRE-ATLAS-202609"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Run paired benign and adversarial workflows with representative tools and attacker-controlled external content.","Record attacker success, authorized task success, blocked benign actions, and the observed unauthorized side effect."],"finding_ids":[],"id":"TEST-01","source_ids":["BENCH-AGENTDOJO","BENCH-INJECAGENT"],"sources":["https://github.com/ethz-spylab/agentdojo","https://github.com/uiuc-kang-lab/InjecAgent"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Measure prompt-injection security and useful task completion","validation":"dynamic"},{"alignment_source_ids":["MITRE-ATLAS-202609"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Vary payload wording, placement, modality, attacker knowledge, and attempts; rerun after changing defenses.","Report per-scenario outcomes, sample counts, attack budget, uncertainty, and model/harness versions instead of only an average."],"finding_ids":[],"id":"TEST-02","source_ids":["NIST-HIJACK-EVAL"],"sources":["https://www.nist.gov/news-events/news/2025/01/technical-blog-strengthening-ai-agent-hijacking-evaluations"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Test adaptively and repeat scenarios","validation":"dynamic"},{"alignment_source_ids":["CIS-MCP-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["In an isolated test environment, exercise invalid tokens, wrong audiences, origin abuse, malicious servers, and protocol fuzzing.","Adapt scenarios to the deployed MCP revision and transports; preserve request/response evidence with secrets removed."],"finding_ids":[],"id":"TEST-03","source_ids":["BENCH-MCPSECBENCH","MCP-AUTH"],"sources":["https://github.com/AIS2Lab/MCPSecBench","https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Exercise MCP authentication and protocol abuse","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Create two principals and attempt cross-access to objects, memory, caches, handles, subscriptions, and execution results.","Repeat after reconnect, delegation, failed authentication, concurrent requests, and privilege revocation."],"finding_ids":[],"id":"TEST-04","source_ids":["BENCH-ASB"],"sources":["https://github.com/agiresearch/ASB"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Verify cross-tenant and cross-agent isolation","validation":"dynamic"},{"alignment_source_ids":["CIS-MCP-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Use explicit forbidden-action canaries to verify enforcement survives hostile content, tool substitution, and delayed execution.","Confirm paths through retries, fallback models, alternate tools, and child agents enforce the same boundary."],"finding_ids":[],"id":"TEST-05","source_ids":["OWASP-AGENT-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/AI_Agent_Security_Cheat_Sheet.html"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Test approval, policy, and sandbox bypass","validation":"dynamic"},{"alignment_source_ids":["NIST-SSDF-AI","CIS-MCP-2026","AIUC1-Q3-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Run language-aware SAST, dependency review, secret scanning, and authorized integration tests for exposed services.","Exercise reachable injection, XSS, SSRF, path traversal, deserialization, and access-control risks with safe fixtures."],"finding_ids":[],"id":"TEST-06","source_ids":["NIST-SSDF","OWASP-OUTPUT2025"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final","https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Verify conventional application security","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Simulate oversized messages, slow peers, streaming floods, repeated errors, runaway agents, and unavailable dependencies.","Verify quotas, shutdown, telemetry, and alerts work together without leaking payloads or losing attribution."],"finding_ids":[],"id":"TEST-07","source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/agentic-ai-harnesses"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Validate resource exhaustion and observability","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Treat repository text and model verdicts as untrusted; test prompt injection, fabricated locations, invalid JSON, and timeouts.","Compare against labeled cases, retain deterministic results, document model variability, and never equate a judge approval with control validation."],"finding_ids":[],"id":"TEST-08","source_ids":["NIST-HIJACK-EVAL","NIST-GENAI"],"sources":["https://www.nist.gov/news-events/news/2025/01/technical-blog-strengthening-ai-agent-hijacking-evaluations","https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Evaluate the optional security judge itself","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","checks":["Where applicable, assess suspicious triggers, model extraction, and disclosure of private training examples under an explicit attacker access and query budget.","Retest acquired or retrained models and adapters before release; document measured failures, model identity, coverage limits, and accepted residual risk."],"finding_ids":[],"id":"TEST-09","source_ids":["CSA-MAESTRO","NIST-SSDF-AI"],"sources":["https://cloudsecurityalliance.org/blog/2025/02/06/agentic-ai-threat-modeling-framework-maestro","https://csrc.nist.gov/pubs/sp/800/218/a/final"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Evaluate model-layer attacks for hosted or customized models","validation":"dynamic"}],"coverage":{"analysis_profiles":{"configuration_lexical":{"files":1,"scope":"Selected text/configuration patterns; YAML anchors, block-scalar semantics and dynamic templates are not fully resolved."},"generic_text":{"files":0,"scope":"Generic secret, URL and applicable text signals only; language-specific execution and dataflow are not analyzed."},"javascript_lexical":{"files":0,"scope":"Bounded JavaScript/TypeScript tokens, calls and configuration signals; not a full JS/TS parser or control-flow analysis."},"json_structured":{"files":1,"scope":"Parsed JSON/JSONC fields and selected configuration rules; runtime values and referenced files are not resolved."},"python_ast":{"files":1,"scope":"Python syntax, bounded local aliases/value tracking and selected security sinks; no whole-program or interprocedural proof."}},"errors":[],"limitations":["Static pattern and local syntax analysis do not prove exploitability, authentication, isolation, or absence of vulnerabilities.","Python receives AST-based call checks; other source languages receive selected textual/configuration checks, not whole-program dataflow.","No dependencies are installed, target code executed, services contacted, or CVE feed queried.","Default excluded directories and unsupported files remain outside the selected scan scope.","Prompt injection resistance, authorization, tenant separation, runtime egress, and human approval need adversarial/runtime validation.","Evidence redaction is best-effort; reports and optional judge payloads can still contain sensitive code or data."],"rules_enabled":["AI001","AI002","AI003","AI004","AI005","AI006","AI007","AI008","AI009","AI010","AI011","AI012","AI013","AI014","AI015","AI016","AI017","AI018","AI019","AI020","AI021","AI022","AI023","AI024","AI025","AI026","AI027","AI028","AI029","AI030","AI031","AI032","AI033","AI034","AI035","AI036","AI037","AI038","AI039","AI040","AI041","AI042"],"skipped":[],"unmatched_baseline_ids":[]},"execution":{"exit_code":1,"failure_threshold":"high","finding_gate_triggered":true},"files":[{"analysis_profile":"configuration_lexical","bytes":81,"path":"Dockerfile","sha256":"596d11f28d436aa9e223c10cbc9eed0421a4fa4f3cd83c1fcb6a045b7c2f170c"},{"analysis_profile":"python_ast","bytes":425,"path":"agent.py","sha256":"3b3621a29f78fb43c3d734039167e034481f667d082ac66d686b2ff26b5703d8"},{"analysis_profile":"json_structured","bytes":290,"path":"mcp.json","sha256":"e037bfafd99865f801f5d673efa3b4221fe5790c4bcd8243d3468191280e3897"}],"findings":[{"category":"tool_execution","confidence":"medium","cwe":["CWE-78"],"description":"A subprocess call enables a shell, invokes a shell-specific API, or passes a dynamic command to an explicit shell executable. Shell metacharacters in agent or external input may become executable syntax.","end_line":9,"evidence":"    subprocess.run(user_command, shell=True)","finding_id":"979d192981c1785a2394fe19","id":"979d192981c1785a2394fe19","line":9,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Pass an argument list with shell=False, allowlist executable names and options, and enforce working-directory and resource restrictions.","rule_id":"AI002","severity":"high","status":"open","title":"Dynamic command executed through a shell"},{"category":"tool_execution","confidence":"medium","cwe":["CWE-78"],"description":"os.system or os.popen executes a dynamically constructed command through the shell. Review the command's trust boundary.","end_line":10,"evidence":"    os.system(user_command)","finding_id":"0fa7e450cd583d78646ef397","id":"0fa7e450cd583d78646ef397","line":10,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Use subprocess with a fixed executable and argument list, shell=False, and explicit allowed options.","rule_id":"AI003","severity":"high","status":"open","title":"Dynamic os shell command"},{"category":"transport_security","confidence":"high","cwe":["CWE-295"],"description":"Certificate verification is explicitly disabled. A network intermediary may impersonate the remote service and capture prompts, credentials, or tool results.","end_line":11,"evidence":"    data = requests.get(remote_url, verify=False)","finding_id":"07fc5f6fd7699fd0194dc479","id":"07fc5f6fd7699fd0194dc479","line":11,"path":"agent.py","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices","https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Enable certificate verification and install the correct CA bundle; use a trusted private CA for custom gateways.","rule_id":"AI006","severity":"high","status":"open","title":"TLS certificate verification disabled"},{"category":"deserialization","confidence":"medium","cwe":["CWE-502"],"description":"Pickle-compatible deserialization can execute code. This finding identifies a dangerous trust boundary, not proof that the serialized input is attacker controlled.","end_line":12,"evidence":"    return pickle.loads(serialized_data), data.text","finding_id":"d2d09fb2875db72f18779bfc","id":"d2d09fb2875db72f18779bfc","line":12,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html"],"remediation":"Use a nonexecutable serialization format with schema validation. If compatibility requires pickle, accept only authenticated artifacts from a strictly controlled producer.","rule_id":"AI005","severity":"high","status":"open","title":"Executable deserialization requires trusted inputs"},{"category":"tool_execution","confidence":"medium","cwe":["CWE-95"],"description":"eval or exec receives a nonliteral expression. If agent, user, or tool content can reach it, it can execute arbitrary Python. Static analysis does not establish the full data flow.","end_line":16,"evidence":"    return eval(model_response)","finding_id":"b1b0f0a3f33fe93875fcb58a","id":"b1b0f0a3f33fe93875fcb58a","line":16,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Replace dynamic execution with an allowlisted operation dispatcher; use ast.literal_eval only for bounded literal parsing. Isolate unavoidable execution with no ambient credentials and strict resource limits.","rule_id":"AI001","severity":"high","status":"open","title":"Dynamic Python code execution"},{"category":"secrets","confidence":"medium","cwe":["CWE-798"],"description":"A credential-named field contains a nonplaceholder literal. It may be a real secret or test data; validate it without disclosing the value.","end_line":6,"evidence":"[REDACTED: credential-related source evidence; inspect this location locally]","finding_id":"afb2bdb94696690028650faf","id":"afb2bdb94696690028650faf","line":6,"path":"mcp.json","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"If real, revoke and rotate the credential, remove it from source and history, and load it from a secret manager or environment variable with least privilege.","rule_id":"AI010","severity":"high","status":"open","title":"Credential-like literal in source or configuration"},{"category":"agent_permissions","confidence":"high","cwe":["CWE-862"],"description":"An agent configuration or command explicitly disables approvals or enables unrestricted execution. The impact depends on the process identity, tools, and sandbox.","end_line":7,"evidence":"      \"autoApprove\": [\"*\"]","finding_id":"592fbfc9b7dab062dc97906c","id":"592fbfc9b7dab062dc97906c","line":7,"path":"mcp.json","references":["https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"Use bounded tool permissions and an isolated runtime; require deliberate approval for destructive, external, financial, or credential-bearing actions.","rule_id":"AI031","severity":"high","status":"open","title":"Agent approval or sandbox safeguard explicitly bypassed"},{"category":"transport_security","confidence":"high","cwe":["CWE-319"],"description":"An MCP configuration points to a nonloopback HTTP URL. Credentials, tool requests, and results may be exposed in transit; network-layer protection is not established by this scan.","end_line":10,"evidence":"      \"url\": \"http://mcp.example.invalid/mcp\"","finding_id":"d841174f55e032505f8136b9","id":"d841174f55e032505f8136b9","line":10,"path":"mcp.json","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"Use HTTPS with certificate verification for remote MCP endpoints. Reserve plaintext HTTP for explicitly controlled local development or a documented protected transport.","rule_id":"AI029","severity":"high","status":"open","title":"Remote MCP URL uses plaintext HTTP"},{"category":"sandboxing","confidence":"high","cwe":["CWE-250"],"description":"The default final Dockerfile stage explicitly selects or inherits a literal root user. Build-target selection, external image defaults, variable expansion and runtime overrides require separate validation.","end_line":3,"evidence":"USER root\nCOPY . /app","finding_id":"20771a324af20de316ec34f9","id":"20771a324af20de316ec34f9","line":2,"path":"Dockerfile","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Use a dedicated nonroot runtime user and minimal capabilities; verify the final build stage and deployment security context.","rule_id":"AI021","severity":"medium","status":"open","title":"Container explicitly runs as root"},{"category":"supply_chain","confidence":"high","cwe":["CWE-829"],"description":"An MCP launch configuration uses npx, uvx, or a similar ephemeral package runner without an exact package version. The executable artifact can change between launches.","end_line":4,"evidence":"      \"command\": \"npx\",","finding_id":"6b77081a826c4c6833edc47f","id":"6b77081a826c4c6833edc47f","line":4,"path":"mcp.json","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices","https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Pin an exact audited package version and lock or verify transitive artifacts. Prefer preinstalled verified tools in a controlled environment.","rule_id":"AI018","severity":"medium","status":"open","title":"MCP package runner resolves an unpinned artifact"},{"category":"supply_chain","confidence":"low","cwe":["CWE-829"],"description":"A container base or deployment image uses a mutable reference rather than a content digest. The bytes can change between builds or deployments.","end_line":1,"evidence":"FROM python:latest","finding_id":"055ed29e5f56926f1827a0b8","id":"055ed29e5f56926f1827a0b8","line":1,"path":"Dockerfile","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Pin approved image digests, track provenance and SBOMs, and update through reviewed vulnerability-remediation workflows.","rule_id":"AI024","severity":"low","status":"open","title":"Container image is not digest pinned"}],"inventory":{"agent_mcp_signals":[{"path":"mcp.json","signals":["mcpservers"]}],"dependency_manifests":[],"extensions":{"(none)":1,".json":1,".py":1}},"judge":{"enabled":false},"methodology":{"areas":[{"area":"Execution and data flow","can_miss_or_misclassify":"Cross-file flows, dynamic imports, wrappers, reflection, generated code, unsupported languages and runtime values can hide a risk. A dangerous API can also be intentional and correctly constrained.","deterministic":"Python AST checks with bounded local aliases/values; JavaScript/TypeScript tokens and balanced calls identify selected eval, shell, deserialization, SQL and template patterns.","optional_review":"A model can explain a retrieved call path, question whether input is trusted and identify contextual concerns the pattern rules do not encode.","runtime_or_human_validation":"Exercise actual entry points with authorized negative tests; verify input provenance, execution privileges and sandbox boundaries."},{"area":"MCP identity, authorization and tools","can_miss_or_misclassify":"Configuration may differ from deployment. External gateways, identity providers, token audience checks and tenant boundaries may be absent from retrieved evidence.","deterministic":"Selected configuration/code signals flag insecure transport, explicit authentication bypass, token passthrough, broad tool grants and unpinned server launch packages.","optional_review":"A model can review supplied authorization logic, tool descriptions and trust-boundary evidence for missing assumptions or inconsistent checks.","runtime_or_human_validation":"Test expired/wrong-audience tokens, cross-tenant access, per-tool authorization, consent binding and the deployed MCP transport."},{"area":"Prompt injection, retrieval and memory","can_miss_or_misclassify":"Adaptive attacks, multi-turn interactions and tool chains depend on runtime behavior. Retrieval can omit the relevant code; a model can overlook an attack or be influenced by hostile evidence.","deterministic":"Selected patterns identify external content placed in privileged model messages and explicit approval/sandbox bypass. This is not an attack simulation.","optional_review":"A model can reason about untrusted-content handling, persistent memory, tool-output influence and missing approval boundaries in the supplied excerpts.","runtime_or_human_validation":"Run isolated adversarial agent/MCP evaluations with attack-success and legitimate-task measurements, plus human review of consequential actions."},{"area":"Secrets and data handling","can_miss_or_misclassify":"Encoded, split or runtime-fetched credentials can be missed; labels/test values can resemble secrets. Neither layer establishes whether a credential is live or redaction is complete.","deterministic":"Selected literal credentials, plausible private-key material, credential-bearing URLs, logging patterns and browser credential exposure are flagged and redacted best-effort.","optional_review":"A model can identify sensitive data flows and retention concerns when the supplied evidence explains their context.","runtime_or_human_validation":"Verify secret stores, credential rotation, logging/retention policy, egress destinations and actual data-access permissions."},{"area":"Built images and supply chain","can_miss_or_misclassify":"Compiled logic, live deployment overrides, signature trust and dependency CVEs are not assessed. Package inventory and archive consistency do not establish safety or publisher identity.","deterministic":"Image archives are reconstructed without starting containers; supported packaged source, metadata, retained credentials, stored permissions and package inventories are inspected.","optional_review":"A model can interpret supplied image/source evidence, flag missing deployment context and propose verification work.","runtime_or_human_validation":"Use vulnerability/advisory analysis, provenance/signature verification and deployment testing alongside the static image assessment."},{"area":"Operations and control effectiveness","can_miss_or_misclassify":"A valid citation proves that a quote exists, not that the model's interpretation is correct. Policies, external services, incident procedures and production outcomes may be unavailable.","deterministic":"The catalog retains governance, monitoring, recovery, approval and isolation checks even where no deterministic rule maps to them.","optional_review":"Full review queues every active acceptance check and can identify evidence gaps or propose runtime/human validation; it can cite exact submitted source text.","runtime_or_human_validation":"Record owner-reviewed evidence, operational exercises and runtime results. A written justification remains an accepted exception, never an automatically validated pass."}],"catalog":{"checks":132,"controls":66,"controls_without_static_mapping":40,"rules":42,"statically_mapped_controls":26},"interpretation":"Mapping counts describe available checks, not percent secure, detection accuracy or validated control effectiveness.","purpose":"Find repeatable security patterns and organize the remaining assurance work for agents, MCP servers and built images.","rule_inventory":[{"category":"tool_execution","id":"AI001","severity":"high","title":"Dynamic Python code execution"},{"category":"tool_execution","id":"AI002","severity":"high","title":"Dynamic command executed through a shell"},{"category":"tool_execution","id":"AI003","severity":"high","title":"Dynamic os shell command"},{"category":"deserialization","id":"AI004","severity":"high","title":"Unsafe YAML object construction"},{"category":"deserialization","id":"AI005","severity":"high","title":"Executable deserialization requires trusted inputs"},{"category":"transport_security","id":"AI006","severity":"high","title":"TLS certificate verification disabled"},{"category":"network_exposure","id":"AI007","severity":"medium","title":"Wildcard cross-origin access"},{"category":"network_exposure","id":"AI008","severity":"low","title":"Service binds to all network interfaces"},{"category":"configuration","id":"AI009","severity":"medium","title":"Application debug mode enabled"},{"category":"secrets","id":"AI010","severity":"high","title":"Credential-like literal in source or configuration"},{"category":"secrets","id":"AI011","severity":"critical","title":"Private key material in repository"},{"category":"tool_execution","id":"AI012","severity":"high","title":"Dynamic JavaScript shell execution"},{"category":"tool_execution","id":"AI013","severity":"high","title":"Dynamic JavaScript code execution"},{"category":"ssrf","id":"AI014","severity":"medium","title":"Externally influenced outbound request"},{"category":"filesystem","id":"AI015","severity":"medium","title":"Externally influenced filesystem path"},{"category":"filesystem","id":"AI016","severity":"medium","title":"Race-prone temporary filename creation"},{"category":"authentication","id":"AI017","severity":"high","title":"JWT verification explicitly bypassed"},{"category":"supply_chain","id":"AI018","severity":"medium","title":"MCP package runner resolves an unpinned artifact"},{"category":"supply_chain","id":"AI019","severity":"high","title":"Remote download piped directly to a shell"},{"category":"supply_chain","id":"AI020","severity":"medium","title":"GitHub Action reference is not pinned to a commit"},{"category":"sandboxing","id":"AI021","severity":"medium","title":"Container explicitly runs as root"},{"category":"sandboxing","id":"AI022","severity":"high","title":"Privileged container or privilege escalation enabled"},{"category":"sandboxing","id":"AI023","severity":"high","title":"Container runtime socket exposed"},{"category":"supply_chain","id":"AI024","severity":"low","title":"Container image is not digest pinned"},{"category":"supply_chain","id":"AI025","severity":"low","title":"Direct dependency is not exactly pinned"},{"category":"authentication","id":"AI026","severity":"high","title":"Authentication explicitly disabled"},{"category":"authorization","id":"AI027","severity":"high","title":"Wildcard tool or permission authorization"},{"category":"authentication","id":"AI028","severity":"high","title":"MCP token passthrough enabled"},{"category":"transport_security","id":"AI029","severity":"high","title":"Remote MCP URL uses plaintext HTTP"},{"category":"secrets","id":"AI030","severity":"medium","title":"Browser-side API credential access explicitly enabled"},{"category":"agent_permissions","id":"AI031","severity":"high","title":"Agent approval or sandbox safeguard explicitly bypassed"},{"category":"prompt_injection","id":"AI032","severity":"medium","title":"External data inserted into privileged LLM instructions"},{"category":"data_protection","id":"AI033","severity":"medium","title":"Potential secret included in logging call"},{"category":"data_protection","id":"AI034","severity":"high","title":"Credential-like value embedded in URL query"},{"category":"model_supply_chain","id":"AI035","severity":"high","title":"Unsafe model checkpoint deserialization"},{"category":"tool_execution","id":"AI036","severity":"high","title":"SQL query constructed with interpolation"},{"category":"filesystem","id":"AI037","severity":"medium","title":"Archive extraction without an explicit safe filter"},{"category":"authentication","id":"AI038","severity":"medium","title":"Cryptographically weak randomness used for a security value"},{"category":"tool_execution","id":"AI039","severity":"high","title":"Server-Side Template rendered from a dynamic template"},{"category":"output_handling","id":"AI040","severity":"medium","title":"Unsafe HTML rendering boundary"},{"category":"authentication","id":"AI041","severity":"high","title":"MCP inspector authorization explicitly disabled"},{"category":"sandboxing","id":"AI042","severity":"high","title":"Container uses host namespaces"}],"schema_version":"1.0","workflow":["Choose an explicit code/image target and scan configuration; no target code or container is started.","Collect bounded deterministic evidence, record hashes, rule matches, exclusions and coverage gaps.","When explicitly enabled, select bounded evidence for finding triage and every active control check; findings-only mode narrows this step.","Run advisory model requests under fixed limits; validate response schemas, known identifiers and exact evidence quotes. The model cannot select files or execute tools through the review controller.","Retain unsupported claims and runtime/human requirements; record user review decisions separately from model advice.","Import an explicitly selected reviewed report with a fresh target scan; revalidate evidence bindings, retain stale decisions for audit and recompute the result."]},"mode":"deterministic_static","review_workspace":{"items":[{"binding_sha256":"27773d89a46b65e9641fec94b2f774439316eb1e2a72ee0a43990d4dd85ea213","decision":"","evidence_ref":"","id":"finding:979d192981c1785a2394fe19","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI002 Dynamic command executed through a shell \u2014 agent.py:9"},{"binding_sha256":"2675419f39b2ce5cab37dd11da0600ef6d5edf652c6207fc4d7d4cf2f0765a6d","decision":"","evidenc