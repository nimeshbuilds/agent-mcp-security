                  "tool_execution",
                  "CWE-89"
                ]
              },
              "shortDescription": {
                "text": "SQL query constructed with interpolation"
              }
            },
            {
              "fullDescription": {
                "text": "A tar extraction call has no explicit safe data filter, or selects a fully trusted filter. Behavior depends on the Python version and archive provenance."
              },
              "help": {
                "text": "Use filter='data' on supported runtimes, validate members and resource limits, and extract into an isolated directory with no sensitive files."
              },
              "id": "AI037",
              "properties": {
                "tags": [
                  "security",
                  "filesystem",
                  "CWE-22"
                ]
              },
              "shortDescription": {
                "text": "Archive extraction without an explicit safe filter"
              }
            },
            {
              "fullDescription": {
                "text": "A credential-, nonce-, or token-named assignment uses a general-purpose random generator. Predictability matters if the value protects access or replay prevention."
              },
              "help": {
                "text": "Use the secrets module or a cryptographically secure runtime API with sufficient entropy for security values."
              },
              "id": "AI038",
              "properties": {
                "tags": [
                  "security",
                  "authentication",
                  "CWE-338"
                ]
              },
              "shortDescription": {
                "text": "Cryptographically weak randomness used for a security value"
              }
            },
            {
              "fullDescription": {
                "text": "A server-side template string is dynamically supplied. If agent or user content controls template source, template expressions may execute with server privileges."
              },
              "help": {
                "text": "Use a fixed trusted template and pass untrusted content only as escaped data; sandbox and limit any intentional template authoring."
              },
              "id": "AI039",
              "properties": {
                "tags": [
                  "security",
                  "tool_execution",
                  "CWE-1336"
                ]
              },
              "shortDescription": {
                "text": "Server-Side Template rendered from a dynamic template"
              }
            },
            {
              "fullDescription": {
                "text": "Dynamic content is passed to an HTML rendering bypass. Agent or tool-generated content may contain executable browser markup if not sanitized."
              },
              "help": {
                "text": "Render untrusted output as text or sanitize with a maintained HTML policy before using a raw-HTML sink; apply a restrictive content security policy."
              },
              "id": "AI040",
              "properties": {
                "tags": [
                  "security",
                  "output_handling",
                  "CWE-79"
                ]
              },
              "shortDescription": {
                "text": "Unsafe HTML rendering boundary"
              }
            },
            {
              "fullDescription": {
                "text": "The MCP inspector's authorization safeguard is explicitly disabled. A reachable inspector may provide access to connected tools and their privileges."
              },
              "help": {
                "text": "Retain inspector authentication and restrict its listeners and origins to a controlled development environment."
              },
              "id": "AI041",
              "properties": {
                "tags": [
                  "security",
                  "authentication",
                  "CWE-306"
                ]
              },
              "shortDescription": {
                "text": "MCP inspector authorization explicitly disabled"
              }
            },
            {
              "fullDescription": {
                "text": "Container configuration explicitly uses the host PID namespace or host networking. This weakens separation between agent tooling and the host."
              },
              "help": {
                "text": "Use isolated namespaces and explicit network rules; document and minimize any unavoidable host-level access."
              },
              "id": "AI042",
              "properties": {
                "tags": [
                  "security",
                  "sandboxing",
                  "CWE-653"
                ]
              },
              "shortDescription": {
                "text": "Container uses host namespaces"
              }
            }
          ],
