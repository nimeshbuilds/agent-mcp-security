his static scan","automated_rule_ids":[],"category":"Operations and resilience","check_dispositions":[{"check_id":"OPS-03:1","check_index":1,"reason":"","status":"active"},{"check_id":"OPS-03:2","check_index":2,"reason":"","status":"active"}],"checks":["Provide a tested stop mechanism that revokes work, credentials, queued actions, and child tasks.","Measure stop latency and verify cancelled or disconnected requests cannot later commit prohibited side effects."],"disabled_finding_ids":[],"finding_ids":[],"id":"OPS-03","justified_finding_ids":[],"source_ids":["JOINT-AGENTIC"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/careful-adoption-of-agentic-ai-services"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Make cancellation and shutdown effective","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Operations and resilience","check_dispositions":[{"check_id":"OPS-04:1","check_index":1,"reason":"","status":"active"},{"check_id":"OPS-04:2","check_index":2,"reason":"","status":"active"}],"checks":["Deny or escalate when policy, identity, or approval checks fail; prevent fallback paths from widening privilege.","Test outages, partial failures, timeouts, retries, idempotency, and recovery of transactions with external effects."],"disabled_finding_ids":[],"finding_ids":[],"id":"OPS-04","justified_finding_ids":[],"source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/agentic-ai-harnesses"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Fail safely and prevent duplicate side effects","validation":"dynamic"},{"alignment_source_ids":["CSA-CCM","CSA-AISMM"],"assurance":"Not established by this static scan","automated_rule_ids":[]