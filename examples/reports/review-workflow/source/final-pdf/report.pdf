","check_index":1,"reason":"","status":"active"},{"check_id":"SUP-03:2","check_index":2,"reason":"","status":"active"}],"checks":["Verify publisher identity, hashes/signatures, build provenance, and intended origin before enabling artifacts.","Review model loading and serialization behavior; an integrity hash cannot make an untrusted publisher safe."],"disabled_finding_ids":[],"finding_ids":["055ed29e5f56926f1827a0b8"],"id":"SUP-03","justified_finding_ids":[],"source_ids":["NSA-DATA","NIST-SSDF"],"sources":["https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/4192332/nsas-aisc-releases-joint-guidance-on-the-risks-and-best-practices-in-ai-data-se/","https://csrc.nist.gov/pubs/sp/800/218/final"],"static_status":"findings_detected","status":"findings_detected","suppressed_finding_ids":[],"title":"Verify artifact identity and provenance","validation":"manual"},{"alignment_source_ids":["NIST-SSDF-AI","CIS-MCP-2026","OPENSSF-BASELINE-202608","SLSA-12"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI020"],"category":"Supply chain","check_dispositions":[{"check_id":"SUP-04:1","check_index":1,"reason":"","status":"active"},{"check_id":"SUP-04:2","check_index":2,"reason":"","status":"active"}],"checks":["Restrict CI credentials and workflow permissions; review actions, build scripts, and release provenance.","Prevent untrusted contributions from executing with deployment secrets or changing approved agent policies."],"disabled_finding_ids":[],"finding_ids":[],"id":"SUP-04","justified_finding_ids":[],"source_ids":["NIST-SSDF"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final"],"static_status":"no_pattern_detected","status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Protect build, release, and configuration changes","validation":"hybrid"},{"alignment_source_ids":["CSA-CCM","CSA-MAESTRO"],"assurance":"Partial static coverage only; absence of a finding is not a pass","a