check_id":"TEST-05:1","check_index":1,"reason":"","status":"active"},{"check_id":"TEST-05:2","check_index":2,"reason":"","status":"active"}],"checks":["Use explicit forbidden-action canaries to verify enforcement survives hostile content, tool substitution, and delayed execution.","Confirm paths through retries, fallback models, alternate tools, and child agents enforce the same boundary."],"disabled_finding_ids":[],"finding_ids":[],"id":"TEST-05","justified_finding_ids":[],"source_ids":["OWASP-AGENT-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/AI_Agent_Security_Cheat_Sheet.html"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Test approval, policy, and sandbox bypass","validation":"dynamic"},{"alignment_source_ids":["NIST-SSDF-AI","CIS-MCP-2026","AIUC1-Q3-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","check_dispositions":[{"check_id":"TEST-06:1","check_index":1,"reason":"","status":"active"},{"check_id":"TEST-06:2","check_index":2,"reason":"","status":"active"}],"checks":["Run language-aware SAST, dependency review, secret scanning, and authorized integration tests for exposed services.","Exercise reachable injection, XSS, SSRF, path traversal, deserialization, and access-control risks with safe fixtures."],"disabled_finding_ids":[],"finding_ids":[],"id":"TEST-06","justified_finding_ids":[],"source_ids":["NIST-SSDF","OWASP-OUTPUT2025"],"sources":["https://csrc.nist.gov/pubs/sp/800/218/final","https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Verify conventional application security","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","check_dispositions":[{"check_id":"TEST-07:1","check_index":1,"reason":"","status":"active"},{"check_id":"TEST-07:2","check_index":2,"reason":"","status":"active"}],"checks":["Simulate oversized messages, slow peers, streaming floods, repeated errors, runaway agents, and unavailable dependencies.","Verify quotas, shutdown, telemetry, and alerts work together without leaking payloads or losing attribution."],"disabled_finding_ids":[],"finding_ids":[],"id":"TEST-07","justified_finding_ids":[],"source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/agentic-ai-harnesses"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Validate resource exhaustion and observability","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","check_dispositions":[{"check_id":"TEST-08:1","check_index":1,"reason":"","status":"active"},{"check_id":"TEST-08:2","check_index":2,"reason":"","status":"active"}],"checks":["Treat repository text and model verdicts as untrusted; test prompt injection, fabricated locations, invalid JSON, and timeouts.","Compare against labeled cases, retain deterministic results, document model variability, and never equate a judge approval with control validation."],"disabled_finding_ids":[],"finding_ids":[],"id":"TEST-08","justified_finding_ids":[],"source_ids":["NIST-HIJACK-EVAL","NIST-GENAI"],"sources":["https://www.nist.gov/news-events/news/2025/01/technical-blog-strengthening-ai-agent-hijacking-evaluations","https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Evaluate the optional security judge itself","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Security validation","check_dispositions":[{"check_id":"TEST-09:1","check_index":1,"reason":"","status":"active"},{"check_id":"TEST-09:2","check_index":2,"reason":"","status":"active"}],"checks":["Where applicable, assess suspicious triggers, model extraction, and disclosure of private training examples under an explicit attacker access and query budget.","Retest acquired or retrained models and adapters before release; document measured failures, model identity, coverage limits, and accepted residual risk."],"disabled_finding_ids":[],"finding_ids":[],"id":"TEST-09","justified_finding_ids":[],"source_ids":["CSA-MAESTRO","NIST-SSDF-AI"],"sources":["https://cloudsecurityalliance.org/blog/2025/02/06/agentic-ai-threat-modeling-framework-maestro","https://csrc.nist.gov/pubs/sp/800/218/a/final"],"static_status":"runtime_validation_required","status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Evaluate model-layer attacks for hosted or customized models","validation":"dynamic"}],"coverage":{"analysis_profiles":{"configuration_lexical":{"files":1,"scope":"Selected text/configuration patterns; YAML anchors, block-scalar semantics and dynamic templates are not fully resolved."},"generic_text":{"files":0,"scope":"Generic secret, URL and applicable text signals only; language-specific execution and dataflow are not analyzed."},"javascript_lexical":{"files":0,"scope":"Bounded JavaScript/TypeScript tokens, calls and configuration signals; not a full JS/TS parser or control-flow analysis."},"json_structured":{"files":1,"scope":"Parsed JSON/JSONC fields and selected configuration rules; runtime values and referenced files are not resolved."},"python_ast":{"files":1,"scope":"Python syntax, bounded local aliases/value tracking and selected security sinks; no whole-program or interprocedural proof."}},"errors":[],"limitations":["Static pattern and local syntax analysis do not prove exploitability, authentication, isolation, or absence of vulnerabilities.","Python receives AST-based call checks; other source languages receive selected textual/configuration checks, not whole-program dataflow.","No dependencies are installed, target code executed, services contacted, or CVE feed queried.","Default excluded directories and unsupported files remain outside the selected scan scope.","Prompt injection resistance, authorization, tenant separation, runtime egress, and human approval need adversarial/runtime validation.","Evidence redaction is best-effort; reports and optional judge payloads can still contain sensitive code or data."],"rules_disabled":[],"rules_enabled":["AI001","AI002","AI003","AI004","AI005","AI006","AI007","AI008","AI009","AI010","AI011","AI012","AI013","AI014","AI015","AI016","AI017","AI018","AI019","AI020","AI021","AI022","AI023","AI024","AI025","AI026","AI027","AI028","AI029","AI030","AI031","AI032","AI033","AI034","AI035","AI036","AI037","AI038","AI039","AI040","AI041","AI042"],"rules_justified":[],"skipped":[],"unmatched_baseline_ids":[]},"execution":{"exit_code":1,"failure_threshold":"high","finding_gate_triggered":true},"files":[{"analysis_profile":"configuration_lexical","bytes":81,"path":"Dockerfile","sha256":"596d11f28d436aa9e223c10cbc9eed0421a4fa4f3cd83c1fcb6a045b7c2f170c"},{"analysis_profile":"python_ast","bytes":425,"path":"agent.py","sha256":"3b3621a29f78fb43c3d734039167e034481f667d082ac66d686b2ff26b5703d8"},{"analysis_profile":"json_structured","bytes":290,"path":"mcp.json","sha256":"e037bfafd99865f801f5d673efa3b4221fe5790c4bcd8243d3468191280e3897"}],"findings":[{"category":"tool_execution","confidence":"medium","cwe":["CWE-78"],"description":"A subprocess call enables a shell, invokes a shell-specific API, or passes a dynamic command to an explicit shell executable. Shell metacharacters in agent or external input may become executable syntax.","disposition":{"id":"979d192981c1785a2394fe19","reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","scope":"finding","status":"justified"},"end_line":9,"evidence":"    subprocess.run(user_command, shell=True)","finding_id":"979d192981c1785a2394fe19","human_review":{"decision":"justified","evidence_ref":"scripts/validate_report_review.py","reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","reviewed_at":"2026-09-19","reviewer":"Invarune workflow test"},"id":"979d192981c1785a2394fe19","line":9,"original_status":"open","path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Pass an argument list with shell=False, allowlist executable names and options, and enforce working-directory and resource restrictions.","rule_id":"AI002","severity":"high","status":"justified","title":"Dynamic command executed through a shell"},{"category":"tool_execution","confidence":"medium","cwe":["CWE-78"],"description":"os.system or os.popen executes a dynamically constructed command through the shell. Review the command's trust boundary.","end_line":10,"evidence":"    os.system(user_command)","finding_id":"0fa7e450cd583d78646ef397","id":"0fa7e450cd583d78646ef397","line":10,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Use subprocess with a fixed executable and argument list, shell=False, and explicit allowed options.","rule_id":"AI003","severity":"high","status":"open","title":"Dynamic os shell command"},{"category":"transport_security","confidence":"high","cwe":["CWE-295"],"description":"Certificate verification is explicitly disabled. A network intermediary may impersonate the remote service and capture prompts, credentials, or tool results.","end_line":11,"evidence":"    data = requests.get(remote_url, verify=False)","finding_id":"07fc5f6fd7699fd0194dc479","id":"07fc5f6fd7699fd0194dc479","line":11,"path":"agent.py","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices","https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Enable certificate verification and install the correct CA bundle; use a trusted private CA for custom gateways.","rule_id":"AI006","severity":"high","status":"open","title":"TLS certificate verification disabled"},{"category":"deserialization","confidence":"medium","cwe":["CWE-502"],"description":"Pickle-compatible deserialization can execute code. This finding identifies a dangerous trust boundary, not proof that the serialized input is attacker controlled.","end_line":12,"evidence":"    return pickle.loads(serialized_data), data.text","finding_id":"d2d09fb2875db72f18779bfc","id":"d2d09fb2875db72f18779bfc","line":12,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html"],"remediation":"Use a nonexecutable serialization format with schema validation. If compatibility requires pickle, accept only authenticated artifacts from a strictly controlled producer.","rule_id":"AI005","severity":"high","status":"open","title":"Executable deserialization requires trusted inputs"},{"category":"tool_execution","confidence":"medium","cwe":["CWE-95"],"description":"eval or exec receives a nonliteral expression. If agent, user, or tool content can reach it, it can execute arbitrary Python. Static analysis does not establish the full data flow.","end_line":16,"evidence":"    return eval(model_response)","finding_id":"b1b0f0a3f33fe93875fcb58a","id":"b1b0f0a3f33fe93875fcb58a","line":16,"path":"agent.py","references":["https://docs.python.org/3/library/security_warnings.html","https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"],"remediation":"Replace dynamic execution with an allowlisted operation dispatcher; use ast.literal_eval only for bounded literal parsing. Isolate unavoidable execution with no ambient credentials and strict resource limits.","rule_id":"AI001","severity":"high","status":"open","title":"Dynamic Python code execution"},{"category":"secrets","confidence":"medium","cwe":["CWE-798"],"description":"A credential-named field contains a nonplaceholder literal. It may be a real secret or test data; validate it without disclosing the value.","end_line":6,"evidence":"[REDACTED: credential-related source evidence; inspect this location locally]","finding_id":"afb2bdb94696690028650faf","id":"afb2bdb94696690028650faf","line":6,"path":"mcp.json","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"If real, revoke and rotate the credential, remove it from source and history, and load it from a secret manager or environment variable with least privilege.","rule_id":"AI010","severity":"high","status":"open","title":"Credential-like literal in source or configuration"},{"category":"agent_permissions","confidence":"high","cwe":["CWE-862"],"description":"An agent configuration or command explicitly disables approvals or enables unrestricted execution. The impact depends on the process identity, tools, and sandbox.","end_line":7,"evidence":"      \"autoApprove\": [\"*\"]","finding_id":"592fbfc9b7dab062dc97906c","id":"592fbfc9b7dab062dc97906c","line":7,"path":"mcp.json","references":["https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"Use bounded tool permissions and an isolated runtime; require deliberate approval for destructive, external, financial, or credential-bearing actions.","rule_id":"AI031","severity":"high","status":"open","title":"Agent approval or sandbox safeguard explicitly bypassed"},{"category":"transport_security","confidence":"high","cwe":["CWE-319"],"description":"An MCP configuration points to a nonloopback HTTP URL. Credentials, tool requests, and results may be exposed in transit; network-layer protection is not established by this scan.","end_line":10,"evidence":"      \"url\": \"http://mcp.example.invalid/mcp\"","finding_id":"d841174f55e032505f8136b9","id":"d841174f55e032505f8136b9","line":10,"path":"mcp.json","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"remediation":"Use HTTPS with certificate verification for remote MCP endpoints. Reserve plaintext HTTP for explicitly controlled local development or a documented protected transport.","rule_id":"AI029","severity":"high","status":"open","title":"Remote MCP URL uses plaintext HTTP"},{"category":"sandboxing","confidence":"high","cwe":["CWE-250"],"description":"The default final Dockerfile stage explicitly selects or inherits a literal root user. Build-target selection, external image defaults, variable expansion and runtime overrides require separate validation.","end_line":3,"evidence":"USER root\nCOPY . /app","finding_id":"20771a324af20de316ec34f9","id":"20771a324af20de316ec34f9","line":2,"path":"Dockerfile","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Use a dedicated nonroot runtime user and minimal capabilities; verify the final build stage and deployment security context.","rule_id":"AI021","severity":"medium","status":"open","title":"Container explicitly runs as root"},{"category":"supply_chain","confidence":"high","cwe":["CWE-829"],"description":"An MCP launch configuration uses npx, uvx, or a similar ephemeral package runner without an exact package version. The executable artifact can change between launches.","end_line":4,"evidence":"      \"command\": \"npx\",","finding_id":"6b77081a826c4c6833edc47f","id":"6b77081a826c4c6833edc47f","line":4,"path":"mcp.json","references":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices","https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Pin an exact audited package version and lock or verify transitive artifacts. Prefer preinstalled verified tools in a controlled environment.","rule_id":"AI018","severity":"medium","status":"open","title":"MCP package runner resolves an unpinned artifact"},{"category":"supply_chain","confidence":"low","cwe":["CWE-829"],"description":"A container base or deployment image uses a mutable reference rather than a content digest. The bytes can change between builds or deployments.","end_line":1,"evidence":"FROM python:latest","finding_id":"055ed29e5f56926f1827a0b8","id":"055ed29e5f56926f1827a0b8","line":1,"path":"Dockerfile","references":["https://www.cisa.gov/resources-tools/resources/secure-by-design"],"remediation":"Pin approved image digests, track provenance and SBOMs, and update through reviewed vulnerability-remediation workflows.","rule_id":"AI024","severity":"low","status":"open","title":"Container image is not digest pinned"}],"inventory":{"agent_mcp_signals":[{"path":"mcp.json","signals":["mcpservers"]}],"dependency_manifests":[],"extensions":{"(none)":1,".json":1,".py":1}},"judge":{"enabled":false},"methodology":{"areas":[{"area":"Execution and data flow","can_miss_or_misclassify":"Cross-file flows, dynamic imports, wrappers, reflection, generated code, unsupported languages and runtime values can hide a risk. A dangerous API can also be intentional and correctly constrained.","deterministic":"Python AST checks with bounded local aliases/values; JavaScript/TypeScript tokens and balanced calls identify selected eval, shell, deserialization, SQL and template patterns.","optional_review":"A model can explain a retrieved call path, question whether input is trusted and identify contextual concerns the pattern rules do not encode.","runtime_or_human_validation":"Exercise actual entry points with authorized negative tests; verify input provenance, execution privileges and sandbox boundaries."},{"area":"MCP identity, authorization and tools","can_miss_or_misclassify":"Configuration may differ from deployment. External gateways, identity providers, token audience checks and tenant boundaries may be absent from retrieved evidence.","deterministic":"Selected configuration/code signals flag insecure transport, explicit authentication bypass, token passthrough, broad tool grants and unpinned server launch packages.","optional_review":"A model can review supplied authorization logic, tool descriptions and trust-boundary evidence for missing assumptions or inconsistent checks.","runtime_or_human_validation":"Test expired/wrong-audience tokens, cross-tenant access, per-tool authorization, consent binding and the deployed MCP transport."},{"area":"Prompt injection, retrieval and memory","can_miss_or_misclassify":"Adaptive attacks, multi-turn interactions and tool chains depend on runtime behavior. Retrieval can omit the relevant code; a model can overlook an attack or be influenced by hostile evidence.","deterministic":"Selected patterns identify external content placed in privileged model messages and explicit approval/sandbox bypass. This is not an attack simulation.","optional_review":"A model can reason about untrusted-content handling, persistent memory, tool-output influence and missing approval boundaries in the supplied excerpts.","runtime_or_human_validation":"Run isolated adversarial agent/MCP evaluations with attack-success and legitimate-task measurements, plus human review of consequential actions."},{"area":"Secrets and data handling","can_miss_or_misclassify":"Encoded, split or runtime-fetched credentials can be missed; labels/test values can resemble secrets. Neither layer establishes whether a credential is live or redaction is complete.","deterministic":"Selected literal credentials, plausible private-key material, credential-bearing URLs, logging patterns and browser credential exposure are flagged and redacted best-effort.","optional_review":"A model can identify sensitive data flows and retention concerns when the supplied evidence explains their context.","runtime_or_human_validation":"Verify secret stores, credential rotation, logging/retention policy, egress destinations and actual data-access permissions."},{"area":"Built images and supply chain","can_miss_or_misclassify":"Compiled logic, live deployment overrides, signature trust and dependency CVEs are not assessed. Package inventory and archive consistency do not establish safety or publisher identity.","deterministic":"Image archives are reconstructed without starting containers; supported packaged source, metadata, retained credentials, stored permissions and package inventories are inspected.","optional_review":"A model can interpret supplied image/source evidence, flag missing deployment context and propose verification work.","runtime_or_human_validation":"Use vulnerability/advisory analysis, provenance/signature verification and deployment testing alongside the static image assessment."},{"area":"Operations and control effectiveness","can_miss_or_misclassify":"A valid citation proves that a quote exists, not that the model's interpretation is correct. Policies, external services, incident procedures and production outcomes may be unavailable.","deterministic":"The catalog retains governance, monitoring, recovery, approval and isolation checks even where no deterministic rule maps to them.","optional_review":"Full review queues every active acceptance check and can identify evidence gaps or propose runtime/human validation; it can cite exact submitted source text.","runtime_or_human_validation":"Record owner-reviewed evidence, operational exercises and runtime results. A written justification remains an accepted exception, never an automatically validated pass."}],"catalog":{"checks":132,"controls":66,"controls_without_static_mapping":40,"rules":42,"statically_mapped_controls":26},"interpretation":"Mapping counts describe available checks, not percent secure, detection accuracy or validated control effectiveness.","purpose":"Find repeatable security patterns and organize the remaining assurance work for agents, MCP servers and built images.","rule_inventory":[{"category":"tool_execution","id":"AI001","severity":"high","title":"Dynamic Python code execution"},{"category":"tool_execution","id":"AI002","severity":"high","title":"Dynamic command executed through a shell"},{"category":"tool_execution","id":"AI003","severity":"high","title":"Dynamic os shell command"},{"category":"deserialization","id":"AI004","severity":"high","title":"Unsafe YAML object construction"},{"category":"deserialization","id":"AI005","severity":"high","title":"Executable deserialization requires trusted inputs"},{"category":"transport_security","id":"AI006","severity":"high","title":"TLS certificate verification disabled"},{"category":"network_exposure","id":"AI007","severity":"medium","title":"Wildcard cross-origin access"},{"category":"network_exposure","id":"AI008","severity":"low","title":"Service binds to all network interfaces"},{"category":"configuration","id":"AI009","severity":"medium","title":"Application debug mode enabled"},{"category":"secrets","id":"AI010","severity":"high","title":"Credential-like literal in source or configuration"},{"category":"secrets","id":"AI011","severity":"critical","title":"Private key material in repository"},{"category":"tool_execution","id":"AI012","severity":"high","title":"Dynamic JavaScript shell execution"},{"category":"tool_execution","id":"AI013","severity":"high","title":"Dynamic JavaScript code execution"},{"category":"ssrf","id":"AI014","severity":"medium","title":"Externally influenced outbound request"},{"category":"filesystem","id":"AI015","severity":"medium","title":"Externally influenced filesystem path"},{"category":"filesystem","id":"AI016","severity":"medium","title":"Race-prone temporary filename creation"},{"category":"authentication","id":"AI017","severity":"high","title":"JWT verification explicitly bypassed"},{"category":"supply_chain","id":"AI018","severity":"medium","title":"MCP package runner resolves an unpinned artifact"},{"category":"supply_chain","id":"AI019","severity":"high","title":"Remote download piped directly to a shell"},{"category":"supply_chain","id":"AI020","severity":"medium","title":"GitHub Action reference is not pinned to a commit"},{"category":"sandboxing","id":"AI021","severity":"medium","title":"Container explicitly runs as root"},{"category":"sandboxing","id":"AI022","severity":"high","title":"Privileged container or privilege escalation enabled"},{"category":"sandboxing","id":"AI023","severity":"high","title":"Container runtime socket exposed"},{"category":"supply_chain","id":"AI024","severity":"low","title":"Container image is not digest pinned"},{"category":"supply_chain","id":"AI025","severity":"low","title":"Direct dependency is not exactly pinned"},{"category":"authentication","id":"AI026","severity":"high","title":"Authentication explicitly disabled"},{"category":"authorization","id":"AI027","severity":"high","title":"Wildcard tool or permission authorization"},{"category":"authentication","id":"AI028","severity":"high","title":"MCP token passthrough enabled"},{"category":"transport_security","id":"AI029","severity":"high","title":"Remote MCP URL uses plaintext HTTP"},{"category":"secrets","id":"AI030","severity":"medium","title":"Browser-side API credential access explicitly enabled"},{"category":"agent_permissions","id":"AI031","severity":"high","title":"Agent approval or sandbox safeguard explicitly bypassed"},{"category":"prompt_injection","id":"AI032","severity":"medium","title":"External data inserted into privileged LLM instructions"},{"category":"data_protection","id":"AI033","severity":"medium","title":"Potential secret included in logging call"},{"category":"data_protection","id":"AI034","severity":"high","title":"Credential-like value embedded in URL query"},{"category":"model_supply_chain","id":"AI035","severity":"high","title":"Unsafe model checkpoint deserialization"},{"category":"tool_execution","id":"AI036","severity":"high","title":"SQL query constructed with interpolation"},{"category":"filesystem","id":"AI037","severity":"medium","title":"Archive extraction without an explicit safe filter"},{"category":"authentication","id":"AI038","severity":"medium","title":"Cryptographically weak randomness used for a security value"},{"category":"tool_execution","id":"AI039","severity":"high","title":"Server-Side Template rendered from a dynamic template"},{"category":"output_handling","id":"AI040","severity":"medium","title":"Unsafe HTML rendering boundary"},{"category":"authentication","id":"AI041","severity":"high","title":"MCP inspector authorization explicitly disabled"},{"category":"sandboxing","id":"AI042","severity":"high","title":"Container uses host namespaces"}],"schema_version":"1.0","workflow":["Choose an explicit code/image target and scan configuration; no target code or container is started.","Collect bounded deterministic evidence, record hashes, rule matches, exclusions and coverage gaps.","When explicitly enabled, select bounded evidence for finding triage and every active control check; findings-only mode narrows this step.","Run advisory model requests under fixed limits; validate response schemas, known identifiers and exact evidence quotes. The model cannot select files or execute tools through the review controller.","Retain unsupported claims and runtime/human requirements; record user review decisions separately from model advice.","Import an explicitly selected reviewed report with a fresh target scan; revalidate evidence bindings, retain stale decisions for audit and recompute the result."]},"mode":"deterministic_static","review_import":{"applied":[{"binding_sha256":"27773d89a46b65e9641fec94b2f774439316eb1e2a72ee0a43990d4dd85ea213","decision":"justified","evidence_ref":"scripts/validate_report_review.py","id":"finding:979d192981c1785a2394fe19","kind":"finding","reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","reviewed_at":"2026-09-19","reviewer":"Invarune workflow test","subject":"AI002 Dynamic command executed through a shell \u2014 agent.py:9"},{"binding_sha256":"44633a08ec4cc1979bd1ba1b366c8a2ca42c950fc2ded0a32a2a94729bbd6df2","decision":"justified","evidence_ref":"scripts/validate_report_review.py","id":"check:GOV-01:1","kind":"check","reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","reviewed_at":"2026-09-19","reviewer":"Invarune workflow test","subject":"GOV-01:1 Record owner, deployment, model/version, MCP transport/version, exposed tools, data classes, and external endpoints."}],"assurance":"Only explicit user fields bound to fresh evidence were imported. User decisions are not validated passes; not redetected does not mean fixed. Report prose and model advice cannot change findings or configuration.","counts":{"applied":2,"decisions":2,"imported_items":143,"not_redetected":0,"out_of_scope":0,"stale":0,"unresolved":0},"enabled":true,"incomplete":false,"not_redetected":[],"origin_scan_id":"30b207d5b14b0ab9ac85d3a22cd28dcef884cfa9f9bdcdac93bb4326b9351884","out_of_scope":[],"source_sha256":"e0271c845ceabf47c64b14c804425b9b458a6ac5714ad5826559341145115e41","stale":[],"status":"completed","unresolved":[]},"review_policy":{"assurance":"User dispositions are not validated passes and are excluded from actionable finding and active review counts. Rule and individual finding dispositions affect their findings; control and check dispositions affect review scope only and never waive static rule findings. Observed evidence and operational coverage gaps remain in the report. Shared static analysis may still collect evidence for disabled rules.","counts":{"active_checks":131,"active_controls":66,"active_rules":42,"catalog_checks":132,"catalog_controls":66,"catalog_rules":42,"disabled_checks":0,"disabled_controls":0,"disabled_rules":0,"excluded_controls":0,"justified_checks":1,"justified_controls":0,"justified_rules":0,"mixed_excluded_controls":0},"enabled":true,"entries":{"checks":{"GOV-01:1":{"reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","status":"justified"}},"controls":{},"findings":{"979d192981c1785a2394fe19":{"reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","status":"justified"}},"rules":{}},"schema_version":"1.0","sha256":"465365cee27f267d542b1f7f62a158d5c7cef210a8ff1f7a4a22b2a251ad55fb"},"review_workspace":{"items":[{"binding_sha256":"27773d89a46b65e9641fec94b2f774439316eb1e2a72ee0a43990d4dd85ea213","decision":"justified","evidence_ref":"scripts/validate_report_review.py","id":"finding:979d192981c1785a2394fe19","kind":"finding","reason":"TEST ONLY: deliberate inert fixture retained for scanner regression. This assertion validates no production safeguard.","reviewed_at":"2026-09-19","reviewer":"Invarune workflow test","subject":"AI002 Dynamic command executed through a shell \u2014 agent.py:9"},{"binding_sha256":"2675419f39b2ce5cab37dd11da0600ef6d5edf652c6207fc4d7d4cf2f0765a6d","decision":"","evidence_ref":"","id":"finding:0fa7e450cd583d78646ef397","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI003 Dynamic os shell command \u2014 agent.py:10"},{"binding_sha256":"586fe34091e0168ab26769438bc6fc5cbd9ced23112ba3420fdae957a79ac64f","decision":"","evidence_ref":"","id":"finding:07fc5f6fd7699fd0194dc479","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI006 TLS certificate verification disabled \u2014 agent.py:11"},{"binding_sha256":"f68a720f121f92b2838e037eea6a4f09ad2fe9a4a225b8a80d572bf8e0552229","decision":"","evidence_ref":"","id":"finding:d2d09fb2875db72f18779bfc","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI005 Executable deserialization requires trusted inputs \u2014 agent.py:12"},{"binding_sha256":"c96fa8cb643a27da7c8cdddf5c892896d5b08268b4118e485ecdd633b54bea99","decision":"","evidence_ref":"","id":"finding:b1b0f0a3f33fe93875fcb58a","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI001 Dynamic Python code execution \u2014 agent.py:16"},{"binding_sha256":"dabdb736f3d6815b982eeacc75e98c53320b22840b3a696e8b2a354d537a0993","decision":"","evidence_ref":"","id":"finding:afb2bdb94696690028650faf","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI010 Credential-like literal in source or configuration \u2014 mcp.json:6"},{"binding_sha256":"1ec9d3989ddff79d71c4d731cbc35e33ea99212e251fbfb2d733cd948bfd6c2e","decision":"","evidence_ref":"","id":"finding:592fbfc9b7dab062dc97906c","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI031 Agent approval or sandbox safeguard explicitly bypassed \u2014 mcp.json:7"},{"binding_sha256":"c9d6f72864ebcfd443c63a65b21e6424bda7147f0d984819bb21a351e5738841","decision":"","evidence_ref":"","id":"finding:d841174f55e032505f8136b9","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI029 Remote MCP URL uses plaintext HTTP \u2014 mcp.json:10"},{"binding_sha256":"87ba49d5b7f358d988d6227891b1eea94c831ae2bb9cdae20b4fe51e2a97fe38","decision":"","evidence_ref":"","id":"finding:20771a324af20de316ec34f9","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI021 Container explicitly runs as root \u2014 Dockerfile:2"},{"binding_sha256":"0d084a38b6b3114ff50bf741cff357b1f12327d931fe63e8517eae3defa80a63","decision":"","evidence_ref":"","id":"finding:6b77081a826c4c6833edc47f","kind":"finding","reason":"","reviewed_at":"","reviewer":"","subject":"AI018 MCP package runner resolves an unpinned artifact \u2014 mcp.json:4"},{"binding_sha256":"d6aa2fcd1da8f0395ddf746c9c8a69e11af6890b3d54