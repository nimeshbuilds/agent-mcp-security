S-MCP-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["Record owner, deployment, model/version, MCP transport/version, exposed tools, data classes, and external endpoints.","Reconcile approved inventory with deployed configurations; investigate unregistered agents and servers."],"finding_ids":[],"id":"GOV-01","source_ids":["NIST-RMF"],"sources":["https://www.nist.gov/publications/artificial-intelligence-risk-management-framework-ai-rmf-10"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Inventory every agent, MCP server, tool, and model","validation":"manual"},{"alignment_source_ids":["CSA-MAESTRO","MITRE-ATLAS-202609"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["Diagram user, model, memory, tool, server, gateway, and downstream service boundaries with their credentials.","Identify who controls each input and the highest-impact action reachable if that input is malicious."],"finding_ids":[],"id":"GOV-02","source_ids":["MITRE-ATLAS","NIST-AML"],"sources":["https://github.com/mitre-atlas/atlas-data","https://csrc.nist.gov/pubs/ai/100/2/e2025/final"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Model trust boundaries and attack paths","validation":"manual"},{"alignment_source_ids":["CSA-AICM","CSA-SCOPING","CSA-AISMM","AIUC1-Q3-2026"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["Assign an owner to each autonomous action and document permitted purposes, forbidden outcomes, and escalation routes.","Record impact, reversibility, approval requirements, and accepted residual risk before production use."],"finding_ids":[],"id":"GOV-03","source_ids":["NIST-RMF","JOINT-AGENTIC"],"sources":["https://www.nist.gov/publications/artificial-intelligence-risk-management-framework-ai-rmf-10","https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/careful-adoption-of-agentic-ai-services"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Define authorized use and accountable owners","validation":"manual"},{"alignment_source_ids":["CSA-AICM","CSA-AISMM","NIST-SSDF-AI"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["Give each control an owner, evidence link, validation date, result, and next review date.","Time-limit exceptions and require a compensating control; distinguish untested behavior from demonstrated failure."],"finding_ids":[],"id":"GOV-04","source_ids":["NIST-GENAI","NIST-SSDF"],"sources":["https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf","https://csrc.nist.gov/pubs/sp/800/218/final"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Maintain evidence and risk exceptions","validation":"manual"},{"alignment_source_ids":["CSA-AICM","CSA-SCOPING"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["Review security impact when adding a model, tool, server, data source, skill, or broader permission.","Require deployment evidence for the complete configured system; a model-only score is insufficient."],"finding_ids":[],"id":"GOV-05","source_ids":["NCSC-SECURE-AI"],"sources":["https://www.ncsc.gov.uk/collection/guidelines-secure-ai-system-development"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Reassess changes in autonomy and integrations","validation":"manual"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Governance","checks":["For each model, gateway, orchestrator, MCP service, and cloud provider, document which party implements each applicable safeguard and which customer configuration it depends on.","Obtain current supplier evidence for inherited safeguards, identify unowned gaps, and record reassessment triggers in the service review."],"finding_ids":[],"id":"GOV-06","source_ids":["CSA-AICM","CSA-CCM"],"sources":["https://cloudsecurityalliance.org/artifacts/ai-controls-matrix-v1-1","https://cloudsecurityalliance.org/artifacts/cloud-controls-matrix-v4-1"],"status":"manual_review_required","suppressed_finding_ids":[],"title":"Assign shared security responsibilities across AI providers","validation":"manual"},{"alignment_source_ids":["CSA-AGENT-IAM","CIS-MCP-2026","OWASP-AISVS-C10"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI026","AI041"],"category":"Identity and authorization","checks":["Trace authentication to every protected HTTP entry point, including tool calls, subscriptions, and retries.","Verify missing, expired, revoked, or malformed credentials cannot invoke a protected operation."],"finding_ids":[],"id":"AUTH-01","source_ids":["MCP-AUTH"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Authenticate protected operations on every request","validation":"hybrid"},{"alignment_source_ids":["CSA-AICM","CSA-AGENT-IAM","CSA-SCOPING","CIS-MCP-2026","OWASP-AISVS-C9","OWASP-AISVS-C10"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI027"],"category":"Identity and authorization","checks":["Check user/agent identity, tenant, tool, target object, and requested operation immediately before execution.","Deny by default; test read-only callers against write tools and object identifiers owned by another user."],"finding_ids":[],"id":"AUTH-02","source_ids":["JOINT-AGENTIC","MCP-TOOLS"],"sources":["https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/careful-adoption-of-agentic-ai-services","https://modelcontextprotocol.io/specification/2026-07-28/server/tools"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Authorize the exact action and target","validation":"hybrid"},{"alignment_source_ids":["CIS-MCP-2026","OWASP-AISVS-C10"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI017"],"category":"Identity and authorization","checks":["Verify signature with trusted keys, allowed algorithms, expected issuer/audience, expiry, and required scopes.","Reject unsigned tokens and tokens minted for another service; decoding a JWT alone is not validation."],"finding_ids":[],"id":"AUTH-03","source_ids":["MCP-AUTH-SEC"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization/security-considerations"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Validate access-token cryptography and claims","validation":"hybrid"},{"alignment_source_ids":["CIS-MCP-2026","OWASP-AISVS-C10"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI028"],"category":"Identity and authorization","checks":["Use audience-bound MCP credentials and separately authorized downstream credentials; never forward arbitrary caller tokens.","Ensure a proxy cannot use its broader service identity to perform an action the caller cannot authorize."],"finding_ids":[],"id":"AUTH-04","source_ids":["MCP-AUTH","MCP-SECURITY"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Prevent token passthrough and confused deputy use","validation":"hybrid"},{"alignment_source_ids":["CSA-AGENT-IAM","CIS-AGENTS-2026","CIS-MCP-2026","OWASP-AISVS-C9"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI010","AI011","AI030","AI034"],"category":"Identity and authorization","checks":["Use short-lived scoped credentials where supported, protect refresh tokens, and validate rotation and revocation.","Avoid tokens in query strings, model context, source, child-process arguments, and diagnostic output."],"finding_ids":["afb2bdb94696690028650faf"],"id":"AUTH-05","source_ids":["MCP-AUTH-SEC","JOINT-DEPLOY"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization/security-considerations","https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Constrain credential lifetime and exposure","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI038"],"category":"Identity and authorization","checks":["Test PKCE support and S256, exact registered redirects, transaction binding, and authorization-response issuer validation.","Reject replayed codes, mismatched issuers, unsafe redirect schemes, and unsolicited callback transactions."],"finding_ids":[],"id":"AUTH-06","source_ids":["MCP-AUTH-SEC","MCP-AUTH"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization/security-considerations","https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Bind OAuth flows and validate redirects","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Identity and authorization","checks":["Validate discovered metadata and client metadata URLs before fetching; constrain schemes, destinations, redirects, and response sizes.","Document trust policy for client registration and prevent discovery from reaching internal metadata or privileged network services."],"finding_ids":[],"id":"AUTH-07","source_ids":["MCP-SECURITY"],"sources":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"status":"review_required","suppressed_finding_ids":[],"title":"Secure OAuth discovery and registration","validation":"hybrid"},{"alignment_source_ids":["CSA-AGENT-IAM","NIST-AGENT-IDENTITY-DRAFT","CIS-AGENTS-2026","CIS-MCP-2026","OWASP-AISVS-C9"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Identity and authorization","checks":["Carry authenticated initiator and delegation identity through multi-agent calls instead of trusting identity fields in text.","Prevent agents from granting themselves privileges; limit delegation scope, depth, lifetime, and downstream audiences."],"finding_ids":[],"id":"AUTH-08","source_ids":["OWASP-AGENT-CS"],"sources":["https://cheatsheetseries.owasp.org/cheatsheets/AI_Agent_Security_Cheat_Sheet.html"],"status":"review_required","suppressed_finding_ids":[],"title":"Bind delegation to identity, scope, and expiry","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"Identity and authorization","checks":["Enroll agents under an accountable sponsor and approved workload identity; verify identity claims before issuing credentials or granting discovery and execution access.","Test retirement, sponsor departure, redeployment, and identity compromise; remove stale credentials, cached grants, registrations, and downstream access."],"finding_ids":[],"id":"AUTH-09","source_ids":["CSA-AGENT-IAM","NIST-AGENT-IDENTITY-DRAFT"],"sources":["https://cloudsecurityalliance.org/artifacts/agentic-ai-identity-and-access-management-a-new-approach","https://www.nccoe.nist.gov/publications/other/accelerating-adoption-software-and-ai-agent-identity-and-authorization-concept"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Manage agent identity enrollment and retirement","validation":"dynamic"},{"alignment_source_ids":["OWASP-AISVS-C10"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI006","AI007","AI008","AI029"],"category":"MCP protocol and tools","checks":["For HTTP, reject invalid Origin values and verify local deployments bind only to intended interfaces.","Use TLS for remote protected endpoints; test DNS rebinding and proxy/header behavior in deployment."],"finding_ids":["07fc5f6fd7699fd0194dc479","d841174f55e032505f8136b9"],"id":"MCP-01","source_ids":["MCP-HTTP"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/transports/streamable-http"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Validate transport exposure and origin","validation":"hybrid"},{"alignment_source_ids":["CIS-MCP-2026","OWASP-AISVS-C9","OWASP-AISVS-C10"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"MCP protocol and tools","checks":["Apply schemas and semantic bounds before executing every tool; reject unknown properties where appropriate.","Bound sizes and nesting; validate declared structured output and render errors without leaking secrets."],"finding_ids":[],"id":"MCP-02","source_ids":["MCP-TOOLS"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/server/tools"],"status":"review_required","suppressed_finding_ids":[],"title":"Validate tool arguments and results","validation":"hybrid"},{"alignment_source_ids":["OWASP-AISVS-C10"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"MCP protocol and tools","checks":["Inspect descriptions, schemas, resources, icons, and results for instructions that cross tool or user boundaries.","Never let readOnlyHint, destructiveHint, or other server claims replace independent authorization and approval policy."],"finding_ids":[],"id":"MCP-03","source_ids":["MCP-TOOLS","OWASP-MCP-CS"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/server/tools","https://cheatsheetseries.owasp.org/cheatsheets/MCP_Security_Cheat_Sheet.html"],"status":"review_required","suppressed_finding_ids":[],"title":"Treat descriptions and annotations as untrusted","validation":"hybrid"},{"alignment_source_ids":["OWASP-AISVS-C10"],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"MCP protocol and tools","checks":["Bind tool approval to verified server identity and the reviewed tool definition or version.","Revalidate changes after reconnect/list updates; disambiguate collisions across servers without trusting display names."],"finding_ids":[],"id":"MCP-04","source_ids":["OWASP-MCP10"],"sources":["https://owasp.org/projects/mcp-top-10"],"status":"review_required","suppressed_finding_ids":[],"title":"Detect tool substitution and metadata changes","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI038"],"category":"MCP protocol and tools","checks":["Authorize every state handle against its owner and tenant; enforce expiry, unpredictability, and replay boundaries.","For older sessionful protocol versions, test session hijacking and cross-user resumption; a session ID is not authentication."],"finding_ids":[],"id":"MCP-05","source_ids":["MCP-TOOLS","MCP-SECURITY"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/server/tools","https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices"],"status":"no_pattern_detected","suppressed_finding_ids":[],"title":"Protect state handles and legacy sessions","validation":"dynamic"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"MCP protocol and tools","checks":["Apply host policy and user control to sampling requests, context sharing, model selection, and associated tool access.","Test whether an untrusted server can induce disclosure from unrelated conversations or recursively consume model budget."],"finding_ids":[],"id":