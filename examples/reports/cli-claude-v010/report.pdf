roxy process-spawn APIs and child filesystem/network permissions; separate stdout protocol traffic from logs."],"finding_ids":["592fbfc9b7dab062dc97906c","6b77081a826c4c6833edc47f"],"id":"MCP-09","source_ids":["MCP-SECURITY","OWASP-MCP-CS"],"sources":["https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices","https://cheatsheetseries.owasp.org/cheatsheets/MCP_Security_Cheat_Sheet.html"],"status":"findings_detected","suppressed_finding_ids":[],"title":"Constrain local server launch and inherited environment","validation":"hybrid"},{"alignment_source_ids":[],"assurance":"Not established by this static scan","automated_rule_ids":[],"category":"MCP protocol and tools","checks":["Record supported revisions and test their capability, metadata, header consistency, stream, and cancellation rules.","Prevent caches and request continuations from crossing authorization contexts; do not apply legacy handshake assumptions universally."],"finding_ids":[],"id":"MCP-10","source_ids":["MCP-TRANSPORTS","MCP-HTTP"],"sources":["https://modelcontextprotocol.io/specification/2026-07-28/basic/transports","https://modelcontextprotocol.io/specification/2026-07-28/basic/transports/streamable-http"],"status":"runtime_validation_required","suppressed_finding_ids":[],"title":"Apply version-aware metadata, caching, and cancellation","validation":"dynamic"},{"alignment_source_ids":["CIS-MCP-2026","OWASP-AISVS-C9","AIUC1-Q3-2026"],"assurance":"Partial static coverage only; absence of a finding is not a pass","automated_rule_ids":["AI027","AI031"],"category":"Agent behavior and context","checks":["Place allow/deny decisions at the execution boundary using trusted policy inputs and constrained tool capabilities.","Show that an injected instruction cannot disable policy, choose privileged credentials, or bypass approval."],"finding_ids":["592fbfc9b7dab062dc97906c"],"id":"AGT-01","source_ids":["ASD-HARNESS"],"sources":["https://www.cyber.gov.au/business-government/se