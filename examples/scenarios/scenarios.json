{
  "schema_version": "1.0",
  "purpose": "Executed documentation journeys, not accuracy or runtime assurance.",
  "scenarios": [
    {
      "id": "01",
      "title": "Install, discover and ask offline",
      "steps": [
        {
          "id": "version",
          "argv": [
            "{cli}",
            "--version"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "0.15.0"
          ]
        },
        {
          "id": "full_help",
          "argv": [
            "{cli}",
            "--help"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "--analyst-investigation-rounds",
            "--image-archive"
          ]
        },
        {
          "id": "short_help",
          "argv": [
            "{cli}",
            "-h"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "--review-report"
          ]
        },
        {
          "id": "all_help",
          "argv": [
            "{cli}",
            "--help-topic",
            "all"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "Custom JSON gateway configuration:"
          ]
        },
        {
          "id": "cookbook",
          "argv": [
            "{cli}",
            "--examples"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "invscan"
          ]
        },
        {
          "id": "inventory",
          "argv": [
            "{cli}",
            "--list-scans",
            "--catalog-format",
            "json"
          ],
          "expected_exit": 0
        },
        {
          "id": "rule",
          "argv": [
            "{cli}",
            "--explain-scan",
            "AI043"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AI043"
          ]
        },
        {
          "id": "rules",
          "argv": [
            "{cli}",
            "--list-rules"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AI047"
          ]
        },
        {
          "id": "controls",
          "argv": [
            "{cli}",
            "--list-controls"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "GOV-01"
          ]
        },
        {
          "id": "rule_alias",
          "argv": [
            "{cli}",
            "--explain-rule",
            "AI002"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AI002"
          ]
        },
        {
          "id": "topics",
          "argv": [
            "{cli}",
            "--list-topics"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "prompt"
          ]
        },
        {
          "id": "question",
          "argv": [
            "{cli}",
            "--ask",
            "How do you check prompt injection?"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AGT-03"
          ]
        },
        {
          "id": "control",
          "argv": [
            "{cli}",
            "--explain-control",
            "AUTH-01"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AUTH-01"
          ]
        },
        {
          "id": "check",
          "argv": [
            "{cli}",
            "--explain-check",
            "AUTH-01:1"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "AUTH-01:1"
          ]
        },
        {
          "id": "sources",
          "argv": [
            "{cli}",
            "--list-sources"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "MITRE-ATLAS"
          ]
        },
        {
          "id": "source",
          "argv": [
            "{cli}",
            "--explain-source",
            "MITRE-ATLAS"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "MITRE-ATLAS"
          ]
        },
        {
          "id": "invarune",
          "argv": [
            "{invarune}",
            "--version"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "0.15.0"
          ]
        },
        {
          "id": "ai-security-scan",
          "argv": [
            "{ai-security-scan}",
            "--version"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "0.15.0"
          ]
        }
      ]
    },
    {
      "id": "02",
      "title": "Scan source and generate every report",
      "steps": [
        {
          "id": "terminal",
          "argv": [
            "{cli}",
            "{repo}/examples/safer"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "Scanned 2 files",
            "Terminal output only"
          ],
          "no_reports_created": true
        },
        {
          "id": "source_reports",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--report",
            "{work}/02-source",
            "--pdf",
            "--summary-json"
          ],
          "expected_exit": 1,
          "report": "{work}/02-source/report.json",
          "report_equals": {
            "summary.open_findings": 11,
            "summary.coverage_gaps": 0,
            "judge.enabled": false,
            "analyst.enabled": false,
            "scoring.overall_security_score": null
          },
          "report_formats": [
            "html",
            "md",
            "json",
            "sarif",
            "pdf"
          ]
        },
        {
          "id": "output_alias",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--output",
            "{work}/02-safe",
            "--summary-json"
          ],
          "expected_exit": 0,
          "report": "{work}/02-safe/report.json",
          "report_equals": {
            "summary.open_findings": 0
          }
        },
        {
          "id": "default_report",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--report",
            "--summary-json"
          ],
          "expected_exit": 0,
          "report": "{cwd}/scan-report/report.json",
          "report_equals": {
            "summary.open_findings": 0
          }
        }
      ]
    },
    {
      "id": "03",
      "title": "Select checks and find malicious skills or tools",
      "steps": [
        {
          "id": "selected_rules",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--scans",
            "AI001,AI002",
            "--summary-json"
          ],
          "expected_exit": 1,
          "stdout_json_equals": {
            "scope.configuration.selected_rule_ids": [
              "AI001",
              "AI002"
            ],
            "reports": {}
          }
        },
        {
          "id": "manual_control",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--scan",
            "GOV-01",
            "--summary-json"
          ],
          "expected_exit": 0,
          "stdout_json_equals": {
            "scoring.deterministic.selected_rules": 0,
            "summary.open_findings": 0,
            "scoring.deterministic.active_checks": 2
          }
        },
        {
          "id": "skill_metadata",
          "argv": [
            "{cli}",
            "{repo}/examples/skills/risky",
            "--scans",
            "AI043,AI044,AI045,AI046",
            "--report",
            "{work}/03-skills",
            "--summary-json"
          ],
          "expected_exit": 1,
          "report": "{work}/03-skills/report.json",
          "report_equals": {
            "summary.open_findings": 4,
            "summary.coverage_gaps": 0
          }
        }
      ]
    },
    {
      "id": "04",
      "title": "Constrain scope and recognize incomplete scans",
      "steps": [
        {
          "id": "bounded_scope",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--exclude",
            "requirements.txt",
            "--exclude",
            "Dockerfile",
            "--max-file-bytes",
            "1000000",
            "--max-total-bytes",
            "5000000",
            "--max-files",
            "100",
            "--max-entries",
            "1000",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 0,
          "stdout_json_equals": {
            "summary.coverage_gaps": 0,
            "scope.configuration.exclude": [
              "Dockerfile",
              "requirements.txt"
            ]
          }
        },
        {
          "id": "file_budget",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--max-file-bytes",
            "10",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 2,
          "stdout_json_equals": {
            "execution.exit_code": 2,
            "scoring.deterministic.selected_scope_complete": false
          }
        },
        {
          "id": "total_budget",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--max-total-bytes",
            "10",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 2,
          "stdout_json_equals": {
            "execution.exit_code": 2,
            "scoring.deterministic.selected_scope_complete": false
          }
        },
        {
          "id": "count_budget",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--max-files",
            "1",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 2,
          "stdout_json_equals": {
            "execution.exit_code": 2,
            "scoring.deterministic.selected_scope_complete": false
          }
        },
        {
          "id": "entry_budget",
          "argv": [
            "{cli}",
            "{repo}/examples/safer",
            "--max-entries",
            "1",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 2,
          "stdout_json_equals": {
            "execution.exit_code": 2,
            "scoring.deterministic.selected_scope_complete": false
          }
        }
      ]
    },
    {
      "id": "05",
      "title": "Inspect built image archives without running them",
      "steps": [
        {
          "id": "image_archive",
          "argv": [
            "{cli}",
            "--image-archive",
            "{repo}/examples/images/demo-agent.tar",
            "--image-platform",
            "linux/amd64",
            "--image-max-archive-bytes",
            "10000000",
            "--image-max-unpacked-bytes",
            "20000000",
            "--image-max-entries",
            "1000",
            "--image-max-layers",
            "10",
            "--report",
            "{work}/05-image",
            "--summary-json"
          ],
          "expected_exit": 1,
          "report": "{work}/05-image/report.json",
          "report_equals": {
            "summary.open_findings": 3,
            "image.container_started": false
          }
        },
        {
          "id": "selected_image",
          "argv": [
            "{cli}",
            "--image-archive",
            "{repo}/examples/images/demo-agent.tar",
            "--scans",
            "AI001",
            "--summary-json"
          ],
          "expected_exit": 0,
          "stdout_json_equals": {
            "summary.open_findings": 0
          }
        },
        {
          "id": "image_help",
          "argv": [
            "{cli}",
            "--help-topic",
            "images"
          ],
          "expected_exit": 0,
          "stdout_contains": [
            "--image-runtime",
            "--pull",
            "--image-timeout"
          ]
        },
        {
          "id": "archive_limit",
          "argv": [
            "{cli}",
            "--image-archive",
            "{repo}/examples/images/demo-agent.tar",
            "--image-max-archive-bytes",
            "1",
            "--summary-json"
          ],
          "expected_exit": 2,
          "stdout_json_equals": {
            "exit_code": 2,
            "status": "operational_error"
          }
        }
      ]
    },
    {
      "id": "06",
      "title": "Use CI gates and reviewed baselines",
      "steps": [
        {
          "id": "quiet_gate",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--quiet"
          ],
          "expected_exit": 1,
          "stdout_empty": true
        },
        {
          "id": "disabled_gate",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--fail-on",
            "none",
            "--summary-json"
          ],
          "expected_exit": 0,
          "stdout_json_equals": {
            "summary.open_findings": 11,
            "execution.finding_gate_triggered": false
          }
        },
        {
          "id": "write_baseline",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--write-baseline",
            "{work}/06-baseline.json",
            "--baseline-reason",
            "TEST ONLY: accepted inert documentation fixture; not production approval.",
            "--summary-json"
          ],
          "expected_exit": 1,
          "stdout_json_equals": {
            "summary.open_findings": 11
          }
        },
        {
          "id": "apply_baseline",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--baseline",
            "{work}/06-baseline.json",
            "--report",
            "{work}/06-baselined",
            "--summary-json"
          ],
          "expected_exit": 0,
          "report": "{work}/06-baselined/report.json",
          "report_equals": {
            "summary.open_findings": 0,
            "summary.suppressed_findings": 11
          }
        }
      ]
    },
    {
      "id": "07",
      "title": "Keep justified and disabled exceptions auditable",
      "steps": [
        {
          "id": "policy",
          "argv": [
            "{cli}",
            "{repo}/examples/vulnerable",
            "--review-config",
            "{repo}/examples/review-config.json",
