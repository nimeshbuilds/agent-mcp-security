citations":[],"model_supplied":false,"reason":"Control review was not started because finding triage or judge configuration failed.","status":"insufficient_evidence","verification_steps":["Collect the required evidence and review this check with its responsible owner."]}],"control_id":"AGT-07","provenance":{"assurance":"Code support is not a control pass or proof of deployed behavior.","citation_validation":"Exact quote in submitted excerpt; semantic interpretation remains advisory.","model_selected_evidence":false,"model_tools_enabled":false,"runtime_execution":false,"static_results_modified":false},"review_status":"not_reviewed","static_status":"findings_detected","title":"Prevent sensitive context leaving through legitimate tools","validation":"dynamic","validation_established":false}],"coverage":{"attempted_controls":0,"call_budget":2,"calls_made":0,"catalog_checks":12,"catalog_controls":6,"disabled_checks":0,"disabled_controls":0,"evidence":{"collection_status":"not_started"},"excluded_checks":0,"excluded_controls":0,"justified_checks":0,"justified_controls":0,"omitted_checks":12,"reviewed_controls":0,"total_checks":12,"total_controls":6,"unreviewed_control_ids":["MCP-03","MCP-04","AGT-02","AGT-03","AGT-06","AGT-07"],"validated_controls":0},"enabled":true,"errors":["Control review was not started because finding triage or judge configuration failed."],"evidence":[],"nondeterministic":true,"provenance":{"assurance":"Code support is not a control pass or proof of deployed behavior.","citation_validation":"Exact quote in submitted excerpt; semantic interpretation remains advisory.","model_selected_evidence":false,"model_tools_enabled":false,"runtime_execution":false,"static_results_modified":false},"requests":[],"routing_policy":"Every active selected acceptance check, including static no-match, parse/coverage uncertainty, and checks with no deterministic rule: static patterns cannot establish completion; justified and disabled checks are excluded without being marked passed.","status":"error"},"assessment":{"coverage_attention":[],"finding_groups":[{"confidence_counts":{"medium":1},"context_note":"Source evidence: deployment reachability and active use have not been established.","control_ids":["AGT-03","AGT-06","MCP-03"],"count":1,"defense_layers":[{"control_ids":["MCP-03","AGT-03","AGT-06"],"how_it_helps":"Replace the instruction with a factual description of inputs, outputs and side effects. Treat returned/retrieved text as data and enforce allowed operations in code outside the model.","id":"instruction-boundary","residual_limit":"A removed literal phrase does not establish immunity to indirect, multilingual, encoded or dynamically generated prompt injection.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Enforce effect and data policy outside model text","verification":"Replay the exact instruction in an isolated agent with harmless canary data and assert the policy-restricted action is denied."},{"control_ids":["MCP-04","AGT-06"],"how_it_helps":"Pin or hash approved artifacts, review changed instructions and metadata, and require deliberate reapproval before use.","id":"artifact-review","residual_limit":"Artifact integrity preserves the approved bytes; it does not prove those bytes are safe or that remote dependencies stay unchanged.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Review and bind the exact tool/skill revision","verification":"Modify a harmless tool description or skill instruction and verify the client rejects the stale approval."}],"finding_ids":["96b10fd3e28d169aec4202f0"],"id":"group-4edf7f3c50c4","image_context":"source","immediate_action":"Quarantine the affected tool/skill revision until its override text has been reviewed; remove unrelated directives and reapprove the exact content hash.","locations":[{"end_line":6,"finding_id":"96b10fd3e28d169aec4202f0","line":6,"path":"SKILL.md"}],"plausible_impact":"A tool description or skill instruction can be inserted into model context before invocation; an override directive attempts to cross the boundary from external data into agent authority.","priority":"P1","rule_id":"AI043","severity":"high","source_ids":["AGENT-SKILLS-SPEC","MCP-TOOLS"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"open","suggested_owner":"Agent/MCP tool or skill owner","title":"Instruction-hierarchy override in agent-facing text"},{"confidence_counts":{"medium":1},"context_note":"Source evidence: deployment reachability and active use have not been established.","control_ids":["AGT-06","AGT-07","MCP-03"],"count":1,"defense_layers":[{"control_ids":["MCP-03","AGT-06","AGT-07"],"how_it_helps":"Use a broker that supplies audience-bound short-lived credentials without placing raw secrets in model context. Allowlist outbound recipients and show the exact payload/recipient for required approval.","id":"instruction-boundary","residual_limit":"Static text cannot establish destination ownership, user consent, live egress enforcement or whether the sensitive object exists.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Enforce effect and data policy outside model text","verification":"Use fake canary credentials and an isolated sink; verify an unapproved destination and encoded/piecemeal disclosure are blocked without transmitting real secrets."},{"control_ids":["MCP-04","AGT-06"],"how_it_helps":"Pin or hash approved artifacts, review changed instructions and metadata, and require deliberate reapproval before use.","id":"artifact-review","residual_limit":"Artifact integrity preserves the approved bytes; it does not prove those bytes are safe or that remote dependencies stay unchanged.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Review and bind the exact tool/skill revision","verification":"Modify a harmless tool description or skill instruction and verify the client rejects the stale approval."}],"finding_ids":["0ef223e5ba79ff454cd3532f"],"id":"group-9371ae2a0fbd","image_context":"source","immediate_action":"Inspect the named data and destination with the owner. Remove unapproved transfer instructions; rotate real credentials only if exposure is established or credibly suspected.","locations":[{"end_line":8,"finding_id":"0ef223e5ba79ff454cd3532f","line":8,"path":"SKILL.md"}],"plausible_impact":"An instruction that directs an agent to gather a credential or sensitive file and send it to a URL/email can turn an otherwise legitimate tool into a disclosure path.","priority":"P1","rule_id":"AI044","severity":"high","source_ids":["AGENT-SKILLS-SPEC","MCP-TOOLS"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"open","suggested_owner":"Agent/MCP tool or skill owner","title":"Sensitive-data transfer instruction"},{"confidence_counts":{"medium":1},"context_note":"Source evidence: deployment reachability and active use have not been established.","control_ids":["AGT-02","AGT-06"],"count":1,"defense_layers":[{"control_ids":["AGT-02","AGT-06"],"how_it_helps":"Have the execution service validate authorization and exact arguments before action; log the operation and reject replayed or changed approvals independently of prompt instructions.","id":"instruction-boundary","residual_limit":"A visible approval prompt alone does not prove the executed target and arguments match what the user approved.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Enforce effect and data policy outside model text","verification":"Exercise the offending instruction with harmless actions, changed arguments, direct MCP calls and a missing/expired approval; all unauthorized effects must fail."},{"control_ids":["MCP-04","AGT-06"],"how_it_helps":"Pin or hash approved artifacts, review changed instructions and metadata, and require deliberate reapproval before use.","id":"artifact-review","residual_limit":"Artifact integrity preserves the approved bytes; it does not prove those bytes are safe or that remote dependencies stay unchanged.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Review and bind the exact tool/skill revision","verification":"Modify a harmless tool description or skill instruction and verify the client rejects the stale approval."}],"finding_ids":["25a65258ee63677ab41cca29"],"id":"group-91180c5839dc","image_context":"source","immediate_action":"Remove the concealment/bypass directive and suspend autonomous use of the affected revision pending review.","locations":[{"end_line":10,"finding_id":"25a65258ee63677ab41cca29","line":10,"path":"SKILL.md"}],"plausible_impact":"Concealment or approval-bypass text in skills/tool descriptions can induce the planner to exceed user-authorized actions under the agent or MCP process identity.","priority":"P1","rule_id":"AI045","severity":"high","source_ids":["AGENT-SKILLS-SPEC","MCP-TOOLS"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"open","suggested_owner":"Agent/MCP tool or skill owner","title":"Covert action or approval-bypass instruction"},{"confidence_counts":{"medium":1},"context_note":"Source evidence: deployment reachability and active use have not been established.","control_ids":["MCP-03","MCP-04"],"count":1,"defense_layers":[{"control_ids":["MCP-03","MCP-04"],"how_it_helps":"Correct readOnlyHint and the description together, version or hash the metadata, and reapprove changed definitions. Enforce read-only credentials or server-side mutation checks independently of the annotation.","id":"instruction-boundary","residual_limit":"A consistent description and annotation can still be dishonest; this check does not prove actual read-only behavior or detect all tool substitution.","source_ids":["MCP-TOOLS"],"sources":[{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Enforce effect and data policy outside model text","verification":"Run against a disposable fixture and compare its before/after state; verify direct unauthorized writes fail even when the client trusts readOnlyHint."},{"control_ids":["MCP-04","AGT-06"],"how_it_helps":"Pin or hash approved artifacts, review changed instructions and metadata, and require deliberate reapproval before use.","id":"artifact-review","residual_limit":"Artifact integrity preserves the approved bytes; it does not prove those bytes are safe or that remote dependencies stay unchanged.","source_ids":["MCP-TOOLS","AGENT-SKILLS-SPEC"],"sources":[{"id":"AGENT-SKILLS-SPEC","title":"Agent Skills specification","url":"https://agentskills.io/specification"},{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"proposed_not_verified","title":"Review and bind the exact tool/skill revision","verification":"Modify a harmless tool description or skill instruction and verify the client rejects the stale approval."}],"finding_ids":["d6d0f54af555b66beabd3017"],"id":"group-cb552e903d07","image_context":"source","immediate_action":"Temporarily handle the tool as potentially mutating; inspect its implementation and effective permissions before enabling autonomous calls.","locations":[{"end_line":5,"finding_id":"d6d0f54af555b66beabd3017","line":5,"path":"tools.json"}],"plausible_impact":"A client may prioritize tools or reduce consent using annotations; an explicit destructive description paired with readOnlyHint=true exposes conflicting metadata at that trust boundary.","priority":"P2","rule_id":"AI046","severity":"medium","source_ids":["MCP-TOOLS"],"sources":[{"id":"MCP-TOOLS","title":"MCP: Tools","url":"https://modelcontextprotocol.io/specification/2026-07-28/server/tools"}],"status":"open","suggested_owner":"Agent/MCP tool or skill owner","title":"Read-only tool annotation contradicts a destructive description"}],"guidance"