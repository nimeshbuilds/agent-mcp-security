                },
                {
                  "action": "Use automation to propose digest updates, rebuild and run agent/MCP regression and policy checks, then roll out the reviewed artifact.",
                  "title": "Update pins deliberately",
                  "verification": "Exercise rollback to a previously approved digest and confirm updates do not silently widen runtime permissions."
                }
              ],
              "summary": "Pin the approved image content digest and maintain a reviewed update process."
            },
