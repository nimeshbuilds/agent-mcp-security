        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "python/packages/autogen-ext/src/autogen_ext/code_executors/docker_jupyter/_jupyter_server.py"
                },
                "region": {
                  "endLine": 328,
                  "startLine": 328
                }
              }
            }
          ],
          "message": {
            "text": "A recognized Python chmod call sets the other-write permission bit. Shared agent workspaces, tool artifacts or credential files may be changed by another local identity. Actual access depends on platform permissions, ownership, ACLs and deployment isolation. Remediation: Use owner-only permissions (typically 0o600 for private files and 0o700 for private directories), or a narrowly controlled shared group where required. Verify access from the actual worker and an unrelated identity; avoid granting 0o777 merely to fix container UID mismatches. Agent/MCP relevance: Another local identity may replace agent-generated code, tool artifacts, instructions or credentials when the shared filesystem permits writes by everyone. Broad permissions can defeat an otherwise correct tool authorization check. Fix steps: 1. Use 0o600 for private files and 0o700 for private directories where applicable. For intentional sharing, assign a controlled group and grant only its needed rights. Fix container UID/GID ownership instead of setting 0o777. Verify: Inspect the resulting mode and ACL on the deployed path; from an unrelated identity, attempt a harmless write and verify it is denied. 2. Use a separate workspace per principal or tenant, mount trusted skills and executable configuration read-only, and exclude credentials from writable artifact directories. Verify: Attempt to replace a canary tool script or neighboring tenant file using the worker identity and confirm the operation is denied. 3. Review code, instructions and sensitive data previously stored in the writable location before trusting them again; validate mounted volumes and startup scripts do not restore broad permissions. Verify: Restart the actual workload, inspect ownership and ACLs again, and confirm a neighboring tenant still cannot alter the canary artifact."
          },
          "partialFingerprints": {
            "agentMcpScan/v1": "257d47ed3712dd8ee1c37599"
          },
          "properties": {
            "agentMcpRemediation": {
              "agent_mcp_relevance": "Another local identity may replace agent-generated code, tool artifacts, instructions or credentials when the shared filesystem permits writes by everyone. Broad permissions can defeat an otherwise correct tool authorization check.",
              "applicability": [
                "The detector proves an explicit other-write mode bit at a recognized Python chmod call; it does not prove a reachable attacker or effective runtime permissions.",
                "A sticky directory bit limits some deletion operations but does not make files read-only; platform ACLs and mount isolation require separate evidence."
              ],
              "catalog_sha256": "1c6da192e79f958ee08a9f7aaef01dd6e193e2a3986a0bb31609ed305a574d94",
              "catalog_version": "1.0.0",
              "control_ids": [
                "EXEC-04"
              ],
              "location": {
                "image_context": "source",
                "line": 328,
                "path": "python/packages/autogen-ext/src/autogen_ext/code_executors/docker_jupyter/_jupyter_server.py"
              },
              "residual_risk": [
                "Correct mode bits do not fix unsafe ownership, permissive ACLs, symbolic-link races or privileged host mounts.",
                "The scanner does not execute chmod or inspect a live filesystem."
              ],
              "rule_id": "AI047",
              "schema_version": "1.0",
              "scope_note": "Inspect the reported source location and its callers, change the implementation or effective configuration, then rebuild and rescan. The scan does not establish that this code is on an active agent or MCP request path.",
              "sources": [
                {
                  "id": "TECH-PYTHON-CHMOD",
                  "relationship": "Supporting engineering guidance; the rule mapping and remediation plan are authored by Invarune.",
                  "title": "Python os.chmod and permission mode flags",
                  "url": "https://docs.python.org/3/library/os.html#os.chmod"
                },
                {
                  "id": "CWE-732",
                  "relationship": "Supporting engineering guidance; the rule mapping and remediation plan are authored by Invarune.",
                  "title": "CWE-732: Incorrect Permission Assignment for Critical Resource",
                  "url": "https://cwe.mitre.org/data/definitions/732.html"
                }
              ],
              "steps": [
                {
                  "action": "Use 0o600 for private files and 0o700 for private directories where applicable. For intentional sharing, assign a controlled group and grant only its needed rights. Fix container UID/GID ownership instead of setting 0o777.",
                  "title": "Set ownership and minimum required mode",
                  "verification": "Inspect the resulting mode and ACL on the deployed path; from an unrelated identity, attempt a harmless write and verify it is denied."
                },
                {
                  "action": "Use a separate workspace per principal or tenant, mount trusted skills and executable configuration read-only, and exclude credentials from writable artifact directories.",
                  "title": "Isolate tool artifacts and sensitive inputs",
