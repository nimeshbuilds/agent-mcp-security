                },
                {
                  "action": "Use separate per-service or per-tenant credentials where supported and restrict which tool workers receive them. Exclude local secret files from version control and build contexts.",
                  "title": "Limit future credential reach",
                  "verification": "Run a tool that does not need the credential and verify it cannot read it; confirm clean builds do not embed injected build secrets."
                }
