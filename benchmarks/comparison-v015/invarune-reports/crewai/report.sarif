                  "url": "https://www.cyber.gov.au/business-government/secure-design/artificial-intelligence/deploying-ai-systems-securely"
                }
              ],
              "steps": [
                {
                  "action": "Replace pickle, dill, joblib or equivalent object loading with JSON or another nonexecutable format plus a versioned schema. Reconstruct only explicitly supported application types.",
                  "title": "Migrate to data-only serialization",
                  "verification": "Roundtrip required benign state and reject unexpected type markers, fields and oversized collections without importing producer-selected code."
                },
                {
                  "action": "If compatibility requires executable deserialization, authenticate the exact bytes against a producer/key or registry digest established independently of the artifact location. Restrict cache and artifact writers.",
                  "title": "Control unavoidable legacy artifacts",
                  "verification": "Alter one byte and change the producer identity in test artifacts; verify rejection before the deserializer is called."
                },
                {
                  "action": "Convert legacy artifacts in a disposable credential-free worker with resource and network limits, then export validated data to the main service.",
                  "title": "Quarantine conversion",
                  "verification": "Verify conversion cannot read main-service secrets or contact forbidden destinations and that failed conversions publish no partial trusted state."
                }
              ],
              "summary": "Replace executable object deserialization or tightly authenticate its producer."
            },
            "confidence": "medium",
            "severity": "high",
            "status": "open"
